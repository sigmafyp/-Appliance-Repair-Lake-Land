---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';

export async function getStaticPaths() {
  const areaEntries = await getCollection('areas');
  return areaEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, zip, responseTime, whyChooseUs, neighborhoods, faq } = entry.data;

const zipDisplay = Array.isArray(zip) ? zip.join(', ') : zip;

const pageTitle = `Appliance Repair in ${title}, FL | Same-Day Service | Lakeland Repair`;
const pageDescription = `Expert local appliance repair in ${title}, FL. Fast same-day service for refrigerators, washers, dryers, dishwashers, and ovens across ZIP ${zipDisplay}. Call (863) 278-0714.`;

// Get other service areas for cross-linking
const allAreas = await getCollection('areas');
const otherAreas = allAreas.filter((a) => a.id !== entry.id).slice(0, 6);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": `Lakeland Repair - ${title} Service Branch`,
  "telephone": "+18632780714",
  "url": `https://appliancerepairlakelandfl.com/areas/${entry.id}/`,
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": `${title}, FL`
  },
  "serviceArea": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": 28.0437,
      "longitude": -81.9560
    },
    "geoRadius": "40000"
  },
  "priceRange": "$$",
  "openingHours": "Mo,Tu,We,Th,Fr,Sa 07:00-19:00"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://appliancerepairlakelandfl.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Service Areas",
      "item": "https://appliancerepairlakelandfl.com/areas/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": `https://appliancerepairlakelandfl.com/areas/${entry.id}/`
    }
  ]
};

const coreServices = [
  { baseName: "Refrigerator Repair", slug: "refrigerator-repair", icon: "🧊", desc: "Fixing Freon leaks, faulty compressors, and temperature control failures." },
  { baseName: "Dishwasher Repair", slug: "dishwasher-repair", icon: "🍽️", desc: "Resolving drainage clogs, spray arm failures, door leaks, and wash pump defects." },
  { baseName: "Cooktop Repair", slug: "cooktop-repair", icon: "🍳", desc: "Precision diagnostics for glass smooth-tops, induction burners, and heat modules." },
  { baseName: "Freezer Repair", slug: "freezer-repair", icon: "❄️", desc: "Restoring sub-zero cooling, defrost timers, start relays, and evaporator fans." },
  { baseName: "Range Hood Repair", slug: "range-hood-repair", icon: "🌬️", desc: "Exhaust blower fan fixes, duct airflow clearing, switches, and lighting repair." },
  { baseName: "Washing Machine Repair", slug: "washer-repair", icon: "🧺", desc: "Stopping standing water, violent drum shaking, and faulty lid latches." },
  { baseName: "Clothes Dryer Repair", slug: "dryer-repair", icon: "🔥", desc: "Restoring heat, replacing broken belts, and clearing thermal safety fuses." },
  { baseName: "Oven & Range Repair", slug: "oven-range-repair", icon: "🍳", desc: "Igniter replacements, thermostat calibrations, and burner repairs." },
  { baseName: "Stove Repair", slug: "stove-repair", icon: "⚡", desc: "Gas burner spark igniters, electric coils, infinite heat switches, and gas valves." },
  { baseName: "Automatic Ice Maker Repair", slug: "ice-maker-repair", icon: "🧊", desc: "Restoring full cube production, unfreezing water lines, and replacing ejectors." },
];
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={[localBusinessSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-brand-teal-dark via-brand-teal to-brand-teal-dark text-white py-14 lg:py-20 overflow-hidden border-b border-teal-800">
    <!-- Subtle Background Ripple Texture Overlay -->
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F2994A_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <!-- Soft Ambient Glow -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-teal-light/20 rounded-full blur-3xl -mr-32 -mt-32 pointer-events-none z-0"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-amber/10 rounded-full blur-3xl -ml-24 -mb-24 pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-800/90 border border-teal-600/50 text-brand-amber text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-brand-success animate-ping"></span>
            Active Mobile Techs in {title}
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white tracking-tight leading-tight">
            Fast, Trusted Appliance Repair in <span class="text-brand-amber">{title}, FL</span>
          </h1>

          <p class="text-base sm:text-lg text-teal-100/95 leading-relaxed font-normal">
            Looking for reliable appliance repair in {title}, FL? When household appliances break in {title}, you need prompt, honest service from licensed local tradespeople. We dispatch fully stocked repair vans throughout ZIP code(s) <strong class="text-white font-mono">{zipDisplay}</strong> for same-day diagnostics and upfront flat-rate quotes.
          </p>

          <!-- Response time card -->
          <div class="p-4 rounded-2xl bg-teal-950/70 backdrop-blur-md border border-teal-700/60 shadow-lg flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-brand-amber/20 border border-brand-amber/30 text-brand-amber flex items-center justify-center shrink-0 shadow-xs">
                <svg class="w-5 h-5 text-brand-amber" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <span class="text-[11px] text-teal-200 block uppercase font-bold tracking-wider">Average Arrival Window</span>
                <span class="text-lg font-heading font-extrabold text-white">{responseTime} in {title}</span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs text-emerald-400 font-bold block flex items-center justify-end gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                Same-Day Slots Open
              </span>
              <span class="text-[11px] text-teal-300">Mon - Sat: 7am – 7pm</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a
              href="tel:+18632780714"
              class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-brand-amber text-slate-900 font-extrabold text-base hover:bg-brand-amber-hover transition-all transform hover:-translate-y-0.5 shadow-xl group text-center"
            >
              <svg class="w-5 h-5 mr-2.5 text-slate-900 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Call (863) 278-0714 Now
            </a>

            <a
              href="/services/"
              class="inline-flex items-center justify-center px-7 py-4 rounded-full bg-teal-800/80 hover:bg-brand-teal-light border border-teal-600/60 text-white font-bold text-base transition-all text-center"
            >
              View All Services
            </a>
          </div>

          <!-- Trust bullets -->
          <div class="pt-4 grid grid-cols-3 gap-2 text-xs text-teal-200/90 border-t border-teal-800">
            <div class="flex items-center gap-1.5">
              <span class="text-brand-success font-bold">✓</span> 90-Day Warranty
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-brand-success font-bold">✓</span> Genuine OEM Parts
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-brand-success font-bold">✓</span> Licensed & Insured
            </div>
          </div>
        </div>

        <!-- Neighborhoods Sidebar Card -->
        <div class="lg:col-span-5">
          <div class="bg-white rounded-3xl p-7 sm:p-8 text-brand-text shadow-2xl border border-gray-100 relative">
            <span class="text-xs font-bold uppercase tracking-widest text-brand-amber block mb-2">Local Neighborhood Coverage</span>
            <h2 class="text-2xl font-heading font-extrabold text-brand-teal mb-4">
              Where We Repair in {title}
            </h2>
            <p class="text-xs text-brand-muted mb-5 leading-relaxed">
              Our service coordinators route licensed technicians throughout {title} and surrounding communities daily:
            </p>

            <ul class="space-y-2.5 mb-6">
              {neighborhoods.map((n) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm font-medium text-gray-700 bg-brand-surface px-3.5 py-2.5 rounded-xl border border-gray-100">
                  <svg class="w-4 h-4 text-brand-teal flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span>{n}</span>
                </li>
              ))}
            </ul>

            <div class="bg-teal-50 border border-teal-100 rounded-2xl p-4 text-center">
              <span class="text-xs text-brand-teal-dark font-bold block mb-1">Serving ZIP Codes:</span>
              <span class="font-mono text-sm font-extrabold text-brand-teal tracking-wide">{zipDisplay}</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Choose Us in This City -->
  <section class="py-16 sm:py-20 bg-white border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="text-brand-amber font-bold tracking-widest uppercase text-xs">Community Focused Service</span>
      <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal">
        Why {title} Homeowners Rely on Lakeland Repair
      </h2>
      <p class="text-base sm:text-lg text-brand-muted leading-relaxed max-w-3xl mx-auto">
        {whyChooseUs}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 text-left">
        <div class="p-6 rounded-2xl bg-brand-surface border border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-teal-100 text-brand-teal flex items-center justify-center font-bold text-lg mb-4">
            🛠️
          </div>
          <h3 class="font-heading font-bold text-brand-teal-dark mb-2">Truck-Stocked Parts</h3>
          <p class="text-xs text-brand-muted leading-relaxed">
            Our vans carry over 500 factory components to complete over 85% of repairs during the very first service visit.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-brand-surface border border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-brand-amber flex items-center justify-center font-bold text-lg mb-4">
            📋
          </div>
          <h3 class="font-heading font-bold text-brand-teal-dark mb-2">Waived Diagnostic Fee</h3>
          <p class="text-xs text-brand-muted leading-relaxed">
            When you approve the repair, our comprehensive diagnostics fee is applied 100% toward your final bill.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-brand-surface border border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-brand-success flex items-center justify-center font-bold text-lg mb-4">
            🛡️
          </div>
          <h3 class="font-heading font-bold text-brand-teal-dark mb-2">90-Day Guarantee</h3>
          <p class="text-xs text-brand-muted leading-relaxed">
            Every installed part and labor hour is backed by our rock-solid 90-day guarantee for your complete peace of mind.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services in this Area -->
  <section class="py-16 sm:py-20 bg-brand-surface border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-brand-amber font-bold tracking-widest uppercase text-xs">Full Diagnostic Capabilities</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal mt-2">
          Appliances We Service in {title}, FL
        </h2>
        <p class="text-sm sm:text-base text-brand-muted mt-3">
          Our certified technicians provide prompt, same-day repairs across all major kitchen and laundry appliances in {title}, FL.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {coreServices.map((service) => (
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-gray-200/90 shadow-sm hover:shadow-xl hover:border-brand-teal hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-teal-50 border border-teal-100 text-2xl flex items-center justify-center group-hover:scale-110 group-hover:bg-brand-amber/15 group-hover:border-amber-200 transition-all duration-300 shadow-2xs">
                  {service.icon}
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-800 bg-teal-100/70 px-2.5 py-1 rounded-full">
                  Active in {title}
                </span>
              </div>

              <h3 class="text-lg font-heading font-extrabold text-brand-teal-dark mb-2 group-hover:text-brand-teal transition-colors">
                <a href={`/services/${service.slug}/`} class="hover:underline">
                  {service.baseName} in {title}
                </a>
              </h3>
              <p class="text-xs text-brand-muted leading-relaxed mb-6 font-normal">
                Certified {service.baseName.toLowerCase()} for homes and rental properties across {title}, FL. {service.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-gray-100 flex items-center gap-2.5">
              <a 
                href={`/services/${service.slug}/`}
                class="flex-1 text-center py-2.5 px-3 rounded-xl bg-teal-50 hover:bg-brand-teal hover:text-white text-brand-teal font-extrabold text-xs transition-all border border-teal-100/80 shadow-2xs flex items-center justify-center gap-1 group/btn"
              >
                <span>Details</span>
                <span class="group-hover/btn:translate-x-0.5 transition-transform">&rarr;</span>
              </a>
              <a 
                href="tel:+18632780714"
                class="flex-1 text-center py-2.5 px-3 rounded-xl bg-brand-teal-dark hover:bg-slate-950 text-white font-extrabold text-xs shadow-md transition-all flex items-center justify-center gap-1.5 group-hover:bg-brand-teal"
              >
                <svg class="w-3.5 h-3.5 text-brand-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <span>Call Now</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Local Area FAQ -->
  <FaqAccordion 
    faqItems={faq} 
    title={`${title} Appliance Repair FAQ`}
    subtitle={`Common questions about in-home appliance repairs in ${title}, FL.`}
  />

  <!-- Nearby Service Areas -->
  <section class="py-14 bg-brand-surface border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
        <h3 class="text-base font-heading font-bold text-brand-teal-dark">
          Other Service Areas Near {title}
        </h3>
        <a href="/areas/" class="text-xs font-bold text-brand-teal hover:text-brand-amber flex items-center gap-1">
          View All Polk County Service Areas &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {otherAreas.map((area) => (
          <a
            href={`/areas/${area.id}/`}
            class="p-3 bg-white rounded-xl border border-gray-200 text-center hover:border-brand-teal hover:shadow-md transition-all group"
          >
            <span class="text-xs font-bold text-brand-text group-hover:text-brand-teal block mb-1">
              {area.data.title}
            </span>
            <span class="text-[10px] text-brand-muted block">
              Avg {area.data.responseTime}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <CtaBanner 
    headline={`Need Urgent Appliance Repair in ${title}?`}
    subhead={`Our local ${title} mobile service vans are standing by. Call our direct dispatch desk now for immediate availability and upfront pricing.`}
    secondaryText="View All Areas"
    secondaryHref="/areas/"
  />
</BaseLayout>
