---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const pageTitle = "Privacy Policy | Lakeland Repair";
const pageDescription = "Privacy policy, data protection standards, and communications practices for Lakeland Repair.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <PageHeader 
    badge="Legal Documentation"
    title="Privacy Policy" 
    description="Last Updated: September 2026 • Our commitment to customer data privacy and transparent communications across Polk County."
  />

  <section class="py-16 sm:py-24 bg-brand-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl shadow-xl border border-gray-100 p-8 sm:p-12 lg:p-16">
        
        <div class="prose prose-slate prose-lg max-w-none text-gray-600 marker:text-brand-teal">
          
          <div class="bg-brand-teal/5 border-l-4 border-brand-teal p-6 rounded-r-2xl mb-12">
            <p class="m-0 font-medium text-brand-teal-dark">
              At Lakeland Repair, we value your trust and are committed to protecting your personal information. This Privacy Policy describes how we collect, use, protect, and handle your data when you visit our website or contact our service dispatch.
            </p>
          </div>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">1. Information We Collect</h2>
          <p>We collect information necessary to schedule, perform, and manage appliance repair services across Polk County, Florida:</p>
          <ul>
            <li><strong>Contact Details:</strong> Your name, phone number, email address, and service address provided when requesting an appointment or service estimate.</li>
            <li><strong>Appliance & Service Information:</strong> Appliance brand, model number, observed symptoms, and repair history.</li>
            <li><strong>Communication Data:</strong> Inquiries, telephone communications, and appointment confirmation details. Calls may be monitored or recorded for quality assurance and training purposes.</li>
            <li><strong>Technical Information:</strong> Standard website log information such as browser type, device information, and pages visited collected via standard cookies and analytics.</li>
          </ul>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">2. How We Use Your Information</h2>
          <p>The information we collect is used exclusively for legitimate business operations:</p>
          <ul>
            <li>Scheduling technician service calls and coordinating same-day or future repair appointments.</li>
            <li>Providing accurate repair estimates, diagnostic explanations, and invoices.</li>
            <li>Sending technician arrival status updates and appointment confirmations.</li>
            <li>Honoring parts and labor warranty records.</li>
            <li>Improving our website performance and customer service standards.</li>
          </ul>
          <p>
            <strong>We do not sell, rent, or trade your personal information to third-party advertisers or telemarketers.</strong>
          </p>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">3. Phone & SMS Communications</h2>
          <p>
            When you call our service line or request service, you consent to receive direct transactional phone calls and SMS notifications regarding your appointment scheduling, diagnostic updates, and technician arrival times. You may opt out of SMS communications at any time by replying "STOP".
          </p>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">4. Data Security & Storage</h2>
          <p>
            We employ industry-standard electronic, administrative, and physical safeguards to protect your personal information against unauthorized access, loss, or misuse.
          </p>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">5. Cookies & Website Analytics</h2>
          <p>
            Our website uses basic cookies to optimize user experience, remember site preferences, and understand website traffic flow. You can adjust your browser settings to decline cookies if you prefer.
          </p>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">6. Your Privacy Rights</h2>
          <p>
            You have the right to request access to the personal data we hold about you, request corrections, or request deletion of your contact records from our non-essential databases, subject to legal recordkeeping obligations.
          </p>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">7. Contact Information</h2>
          <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 mt-6">
            <p class="m-0 text-sm">
              For any questions regarding this Privacy Policy or your personal information, please reach out to our office:<br><br>
              <strong>Lakeland Repair</strong><br>
              Lakeland, FL 33801<br>
              Phone: <a href="tel:+18632780714" class="text-brand-amber font-bold hover:underline">(863) 278-0714</a>
            </p>
          </div>

        </div>
      </div>
    </div>
  </section>

</BaseLayout>
