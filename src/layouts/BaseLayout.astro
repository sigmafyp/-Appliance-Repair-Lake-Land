---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  canonicalUrl?: string;
}

const { title, description, schema, canonicalUrl } = Astro.props;
const currentUrl = canonicalUrl || Astro.url.href;

const baseLocalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": "Lakeland Repair",
  "image": "https://appliancerepairlakelandfl.com/images/hero/hero-tech.jpg",
  "@id": "https://appliancerepairlakelandfl.com/#organization",
  "url": "https://appliancerepairlakelandfl.com",
  "telephone": "+18632780714",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Lakeland",
    "addressRegion": "FL",
    "postalCode": "33801",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 28.0437,
    "longitude": -81.9560
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "07:00",
      "closes": "19:00"
    }
  ],
  "areaServed": [
    "Lakeland", "Winter Haven", "Plant City", "Auburndale", "Mulberry", "Bartow", "Haines City", "Davenport", "Polk City", "Lake Wales", "Polk County FL"
  ]
};

const schemasToInject = schema 
  ? (Array.isArray(schema) ? [baseLocalBusinessSchema, ...schema] : [baseLocalBusinessSchema, schema])
  : [baseLocalBusinessSchema];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0F3B3E" />
    <meta name="google-site-verification" content="bF4gyH02OXrf9vM3q6VsG7qupdBMAFz_CH276APVwVA" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Geo / Local SEO Meta Tags -->
    <meta name="geo.region" content="US-FL" />
    <meta name="geo.placename" content="Lakeland, Polk County, Florida" />
    <meta name="geo.position" content="28.0437;-81.9560" />
    <meta name="ICBM" content="28.0437, -81.9560" />

    <!-- AOS Animation CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <!-- Title & Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content="Lakeland Repair" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://appliancerepairlakelandfl.com/images/hero/hero-tech.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lakeland Appliance Repair Service Technician" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://appliancerepairlakelandfl.com/images/hero/hero-tech.jpg" />

    <!-- JSON-LD Schema Markup -->
    {schemasToInject.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="bg-brand-bg text-brand-text flex flex-col min-h-screen font-sans antialiased selection:bg-brand-amber selection:text-white">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    
    <!-- AOS Animation JS -->
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        AOS.init({
          duration: 800,
          once: true,
          offset: 100,
          easing: 'ease-out-cubic'
        });
      });
    </script>
  </body>
</html>
