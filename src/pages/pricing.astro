---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';

const pageTitle = "Transparent Appliance Repair Pricing & Diagnostic Fees | Lakeland Repair";
const pageDescription = "Honest, upfront appliance repair pricing in Lakeland & Polk County, FL. Diagnostic fee waived with repair. 90-day parts and labor warranty included. Call (863) 555-0123.";

const pricingRanges = [
  { appliance: "Refrigerator & Freezer", typicalRange: "$150 – $380+", commonFixes: "Start relays, defrost heaters, evaporator fan motors, thermistors, water valves" },
  { appliance: "Washing Machine", typicalRange: "$140 – $320+", commonFixes: "Drain pumps, lid switch/door locks, drive belts, water inlet valves, suspension rods" },
  { appliance: "Clothes Dryer", typicalRange: "$130 – $290+", commonFixes: "Heating elements, thermal fuses, drum rollers, drive belts, cycling thermostats" },
  { appliance: "Dishwasher", typicalRange: "$140 – $310+", commonFixes: "Circulation pumps, drain impellers, door gaskets, float switches, spray arms" },
  { appliance: "Oven, Stove & Range", typicalRange: "$140 – $340+", commonFixes: "Gas surface igniters, bake/broil elements, spark ignition modules, safety valves" },
  { appliance: "Automatic Ice Maker", typicalRange: "$130 – $275+", commonFixes: "Ice mold ejectors, water inlet solenoids, modular thermostat heads, fill tubes" },
];

const pricingFaqs = [
  {
    question: "Do you charge a diagnostic service fee?",
    answer: "Yes, we charge an initial standard diagnostic fee that covers technician travel, fuel, and detailed multi-point mechanical and electrical testing. However, if you choose to proceed with our recommended repair, the entire diagnostic fee is 100% waived and credited toward your final total."
  },
  {
    question: "Will I receive a written estimate before any repair work begins?",
    answer: "Always. We operate strictly on upfront, flat-rate pricing. The technician will thoroughly diagnose the problem, explain the required repair, and present an exact written quote for parts and labor before turning a single screw. There are never surprise fees or hourly overages."
  },
  {
    question: "Are parts and labor covered under warranty?",
    answer: "Yes. Every repair performed by Lakeland Repair comes with our comprehensive 90-day parts and labor warranty. If the installed component experiences any defect or failure within 90 days, we return and fix it at zero extra cost."
  },
  {
    question: "What payment methods do you accept?",
    answer: "For your convenience, our mobile technicians accept all major credit cards (Visa, MasterCard, American Express, Discover), debit cards, and local checks."
  }
];

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "PriceSpecification",
  "priceCurrency": "USD",
  "name": "Lakeland Appliance Repair Pricing",
  "description": pageDescription
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={pricingSchema}>
  <PageHeader 
    title="Transparent Appliance Repair Pricing" 
    description="No hidden diagnostics charges, no surprise hourly rates. Just honest upfront pricing backed by our 90-day guarantee." 
  />

  <!-- Upfront Pricing Commitment -->
  <section class="py-16 sm:py-20 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
        <div class="p-8 rounded-3xl bg-brand-surface border border-gray-200/90 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-100 text-brand-amber flex items-center justify-center font-bold text-xl mb-6">
              💡
            </div>
            <h3 class="text-xl font-heading font-extrabold text-brand-teal-dark mb-3">
              Diagnostic Fee Waived
            </h3>
            <p class="text-sm text-brand-muted leading-relaxed">
              When our technician identifies the issue and you approve the repair, the diagnostic fee is completely applied to your repair cost. You only pay for the fix!
            </p>
          </div>
          <span class="text-xs font-bold text-brand-amber uppercase tracking-wider mt-6 block">Zero Double-Charging</span>
        </div>

        <div class="p-8 rounded-3xl bg-brand-surface border border-gray-200/90 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-teal-100 text-brand-teal flex items-center justify-center font-bold text-xl mb-6">
              📑
            </div>
            <h3 class="text-xl font-heading font-extrabold text-brand-teal-dark mb-3">
              Flat-Rate Written Quotes
            </h3>
            <p class="text-sm text-brand-muted leading-relaxed">
              We price by the job, not by the clock. Even if a complex repair takes extra time, the price we quote upfront is the exact price you pay at completion.
            </p>
          </div>
          <span class="text-xs font-bold text-brand-teal uppercase tracking-wider mt-6 block">No Hourly Overages</span>
        </div>

        <div class="p-8 rounded-3xl bg-brand-surface border border-gray-200/90 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-brand-success flex items-center justify-center font-bold text-xl mb-6">
              🛡️
            </div>
            <h3 class="text-xl font-heading font-extrabold text-brand-teal-dark mb-3">
              90-Day Complete Warranty
            </h3>
            <p class="text-sm text-brand-muted leading-relaxed">
              Every factory OEM replacement part and every labor hour is guaranteed for 90 days. If the same issue returns, we correct it at zero cost.
            </p>
          </div>
          <span class="text-xs font-bold text-brand-success uppercase tracking-wider mt-6 block">100% Risk-Free Guarantee</span>
        </div>
      </div>

      <!-- Price Estimate Table -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-xl overflow-hidden mb-16">
        <div class="p-6 sm:p-8 bg-brand-teal text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <h2 class="text-2xl font-heading font-extrabold text-white">
              Estimated Repair Price Ranges
            </h2>
            <p class="text-xs sm:text-sm text-teal-100/90 mt-1">
              General Polk County estimates including diagnostics, authentic parts, and labor:
            </p>
          </div>
          <a
            href="tel:8635550123"
            class="px-6 py-3 rounded-full bg-brand-amber text-slate-900 font-extrabold text-xs tracking-wider uppercase hover:bg-brand-amber-hover transition-colors whitespace-nowrap shadow-md"
          >
            Get Live Quote: (863) 555-0123
          </a>
        </div>

        <div class="divide-y divide-gray-100">
          {pricingRanges.map((item) => (
            <div class="p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:bg-gray-50/80 transition-colors">
              <div class="md:w-1/3">
                <h3 class="font-heading font-bold text-brand-teal-dark text-lg mb-1">
                  {item.appliance}
                </h3>
                <span class="text-xs font-bold text-brand-amber font-mono">
                  Typical: {item.typicalRange}
                </span>
              </div>
              <div class="md:w-2/3">
                <span class="text-xs text-brand-muted font-semibold block mb-1">Frequently Replaced Components:</span>
                <p class="text-xs text-gray-600 leading-relaxed">
                  {item.commonFixes}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Pricing FAQs -->
  <section class="py-16 sm:py-20 bg-brand-surface border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-brand-amber font-bold tracking-widest uppercase text-xs">Clear Policies</span>
        <h2 class="text-3xl font-heading font-extrabold text-brand-teal mt-2">
          Pricing & Diagnostic FAQs
        </h2>
      </div>

      <div class="space-y-4">
        {pricingFaqs.map((faq) => (
          <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <h3 class="text-base font-heading font-bold text-brand-teal-dark mb-2">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner 
    headline="Ready for Upfront, Honest Repair Pricing?"
    subhead="Call our Polk County dispatch desk now. We will provide our immediate diagnostic arrival window and dispatch a technician to your door."
    secondaryText="Browse Repair Services"
    secondaryHref="/services/"
  />
</BaseLayout>
