---

<section class="py-16 sm:py-20 bg-brand-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-2">Why Polk County Trusts Us</h2>
      <p class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal tracking-tight">
        Engineered for Speed, Precision, & Peace of Mind
      </p>
      <p class="mt-4 text-base text-brand-muted">
        We combine master trade technical skill with honest Florida hospitality. Here is why homeowners and landlords choose Lakeland Appliance Pro.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((item) => (
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-md hover:shadow-xl transition-all transform hover:-translate-y-1 group">
          <div class="w-12 h-12 rounded-xl bg-teal-50 text-brand-teal flex items-center justify-center mb-6 group-hover:bg-brand-amber group-hover:text-slate-900 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}/>
            </svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-brand-text mb-3">
            {item.title}
          </h3>
          <p class="text-sm text-brand-muted leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
