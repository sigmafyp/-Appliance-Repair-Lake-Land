---
<section class="py-10 bg-gradient-to-b from-brand-surface to-white border-b border-gray-100 relative overflow-hidden">
  <div class="absolute top-0 w-full h-[1px] bg-gradient-to-r from-transparent via-brand-teal/20 to-transparent"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      
      <div class="group flex flex-col items-center text-center p-6 rounded-2xl transition-all duration-300 hover:bg-white hover:shadow-[0_10px_40px_-15px_rgba(13,148,136,0.15)] hover:-translate-y-1">
        <div class="w-14 h-14 bg-gradient-to-br from-teal-50 to-teal-100 text-brand-teal rounded-2xl flex items-center justify-center mb-4 shadow-inner border border-teal-200/50 group-hover:scale-110 transition-transform duration-300 group-hover:from-teal-100 group-hover:to-brand-teal group-hover:text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h4 class="font-heading font-bold text-[15px] text-brand-text mb-1.5">Same-Day Dispatch</h4>
        <p class="text-xs text-brand-muted font-medium">Urgent service across Polk County.</p>
      </div>

      <div class="group flex flex-col items-center text-center p-6 rounded-2xl transition-all duration-300 hover:bg-white hover:shadow-[0_10px_40px_-15px_rgba(13,148,136,0.15)] hover:-translate-y-1 relative">
        <div class="hidden md:block absolute left-0 top-1/2 -translate-y-1/2 w-[1px] h-12 bg-gradient-to-b from-transparent via-gray-200 to-transparent"></div>
        <div class="w-14 h-14 bg-gradient-to-br from-teal-50 to-teal-100 text-brand-teal rounded-2xl flex items-center justify-center mb-4 shadow-inner border border-teal-200/50 group-hover:scale-110 transition-transform duration-300 group-hover:from-teal-100 group-hover:to-brand-teal group-hover:text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <h4 class="font-heading font-bold text-[15px] text-brand-text mb-1.5">Licensed & Certified</h4>
        <p class="text-xs text-brand-muted font-medium">Qualified to handle all repairs safely.</p>
      </div>

      <div class="group flex flex-col items-center text-center p-6 rounded-2xl transition-all duration-300 hover:bg-white hover:shadow-[0_10px_40px_-15px_rgba(13,148,136,0.15)] hover:-translate-y-1 relative">
        <div class="hidden md:block absolute left-0 top-1/2 -translate-y-1/2 w-[1px] h-12 bg-gradient-to-b from-transparent via-gray-200 to-transparent"></div>
        <div class="w-14 h-14 bg-gradient-to-br from-teal-50 to-teal-100 text-brand-teal rounded-2xl flex items-center justify-center mb-4 shadow-inner border border-teal-200/50 group-hover:scale-110 transition-transform duration-300 group-hover:from-teal-100 group-hover:to-brand-teal group-hover:text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        </div>
        <h4 class="font-heading font-bold text-[15px] text-brand-text mb-1.5">Fully Stocked Vans</h4>
        <p class="text-xs text-brand-muted font-medium">OEM parts for on-the-spot fixes.</p>
      </div>

      <div class="group flex flex-col items-center text-center p-6 rounded-2xl transition-all duration-300 hover:bg-white hover:shadow-[0_10px_40px_-15px_rgba(13,148,136,0.15)] hover:-translate-y-1 relative">
        <div class="hidden md:block absolute left-0 top-1/2 -translate-y-1/2 w-[1px] h-12 bg-gradient-to-b from-transparent via-gray-200 to-transparent"></div>
        <div class="w-14 h-14 bg-gradient-to-br from-teal-50 to-teal-100 text-brand-teal rounded-2xl flex items-center justify-center mb-4 shadow-inner border border-teal-200/50 group-hover:scale-110 transition-transform duration-300 group-hover:from-teal-100 group-hover:to-brand-teal group-hover:text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h4 class="font-heading font-bold text-[15px] text-brand-text mb-1.5">Honest Pricing</h4>
        <p class="text-xs text-brand-muted font-medium">No hidden fees, full written estimate.</p>
      </div>

    </div>
  </div>
</section>
