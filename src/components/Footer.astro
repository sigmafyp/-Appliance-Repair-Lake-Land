---
const services = [
  { name: 'Refrigerator Repair', href: '/services/refrigerator-repair' },
  { name: 'Freezer Repair', href: '/services/freezer-repair' },
  { name: 'Washer Repair', href: '/services/washer-repair' },
  { name: 'Dryer Repair', href: '/services/dryer-repair' },
  { name: 'Oven & Range Repair', href: '/services/oven-range-repair' },
  { name: 'Stove Repair', href: '/services/stove-repair' },
  { name: 'Cooktop Repair', href: '/services/cooktop-repair' },
  { name: 'Dishwasher Repair', href: '/services/dishwasher-repair' },
  { name: 'Microwave Repair', href: '/services/microwave-repair' },
  { name: 'Ice Maker Repair', href: '/services/ice-maker-repair' },
  { name: 'Range Hood Repair', href: '/services/range-hood-repair' },
  { name: 'Garbage Disposal Repair', href: '/services/garbage-disposal-repair' },
  { name: 'Commercial Appliance Repair', href: '/services/commercial-appliance-repair' },
];

const serviceAreas = [
  { name: 'Downtown Lakeland', href: '/areas/downtown-lakeland' },
  { name: 'South Lakeland', href: '/areas/south-lakeland' },
  { name: 'Winter Haven', href: '/areas/winter-haven' },
  { name: 'Plant City', href: '/areas/plant-city' },
  { name: 'Auburndale', href: '/areas/auburndale' },
  { name: 'Mulberry', href: '/areas/mulberry' },
  { name: 'Bartow', href: '/areas/bartow' },
  { name: 'Highland City', href: '/areas/highland-city' },
  { name: 'Dixieland Lakeland', href: '/areas/dixieland-lakeland' },
  { name: 'Lake Morton Lakeland', href: '/areas/lake-morton-lakeland' },
];
---

<footer class="bg-brand-teal-dark text-slate-200 pt-16 pb-12 border-t-4 border-brand-amber">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-teal-800">
      
      <!-- Column 1: Brand Blurb -->
      <div class="space-y-4">
        <div class="flex items-center space-x-3">
          <img src="/logo.png" alt="Lakeland Repair" class="w-12 h-12 drop-shadow-md rounded-lg" />
          <span class="font-heading font-extrabold text-xl text-white tracking-tight">
            Lakeland<span class="text-brand-amber">Repair</span>
          </span>
        </div>
        <p class="text-sm text-teal-100/80 leading-relaxed">
          Lakeland & Polk County’s most dependable local appliance repair specialists. Delivering prompt, same-day service with upfront pricing, certified technicians, and a 100% satisfaction guarantee.
        </p>
        <div class="pt-2">
          <div class="inline-flex items-center space-x-2 text-xs font-semibold text-brand-amber bg-teal-900/80 px-3 py-1.5 rounded-full border border-teal-700">
            <svg class="w-4 h-4 text-brand-success" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>FL License & Insured • Local Trade Specialists</span>
          </div>
        </div>
      </div>

      <!-- Column 2: All 14 Services -->
      <div>
        <h3 class="text-white font-heading font-bold text-base mb-4 tracking-wide uppercase text-brand-amber">
          Appliance Services
        </h3>
        <ul class="grid grid-cols-1 gap-1.5 text-xs text-teal-100/90">
          {services.map((service) => (
            <li>
              <a href={service.href} class="hover:text-brand-amber transition-colors flex items-center py-0.5">
                <span class="text-brand-amber mr-1.5">›</span> {service.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: All 10 Service Areas -->
      <div>
        <h3 class="text-white font-heading font-bold text-base mb-4 tracking-wide uppercase text-brand-amber">
          Polk County Service Areas
        </h3>
        <ul class="grid grid-cols-1 gap-1.5 text-xs text-teal-100/90">
          {serviceAreas.map((area) => (
            <li>
              <a href={area.href} class="hover:text-brand-amber transition-colors flex items-center py-0.5">
                <span class="text-brand-amber mr-1.5">›</span> {area.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact & Operating Hours -->
      <div class="space-y-4">
        <h3 class="text-white font-heading font-bold text-base mb-4 tracking-wide uppercase text-brand-amber">
          Direct Contact & Hours
        </h3>
        <ul class="space-y-3 text-xs text-teal-100/90">
          <li class="flex items-start space-x-2.5">
            <svg class="w-4 h-4 text-brand-amber mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <div>
              <span class="font-semibold text-white block">Dispatch Line:</span>
              <a href="tel:8635550123" class="text-brand-amber font-bold text-sm hover:underline">(863) 555-0123</a>
            </div>
          </li>
          <li class="flex items-start space-x-2.5">
            <svg class="w-4 h-4 text-brand-amber mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <span class="font-semibold text-white block">Headquarters:</span>
              <span>120 E Pine St, Suite 4, Lakeland, FL 33801</span>
            </div>
          </li>
          <li class="flex items-start space-x-2.5">
            <svg class="w-4 h-4 text-brand-amber mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div>
              <span class="font-semibold text-white block">Dispatch Hours:</span>
              <span>Mon - Sat: 7:00 AM – 7:00 PM</span><br/>
              <span class="text-amber-300 font-medium">Emergency Service Available</span>
            </div>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-teal-200/70 space-y-4 sm:space-y-0">
      <div>
        © {new Date().getFullYear()} Lakeland Repair. All rights reserved. Lakeland & Polk County, FL.
      </div>
      <div class="flex items-center space-x-6">
        <a href="/faq" class="hover:text-brand-amber transition-colors">FAQ</a>
        <a href="/privacy-policy" class="hover:text-brand-amber transition-colors">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-brand-amber transition-colors">Terms of Service</a>
        <a href="/contact" class="hover:text-brand-amber transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
