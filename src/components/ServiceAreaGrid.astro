---
const areas = [
  { slug: 'downtown-lakeland', name: 'Downtown Lakeland', zip: '33801', responseTime: '30-60 mins' },
  { slug: 'south-lakeland', name: 'South Lakeland', zip: '33813', responseTime: '45-60 mins' },
  { slug: 'winter-haven', name: 'Winter Haven', zip: '33880', responseTime: '45-90 mins' },
  { slug: 'plant-city', name: 'Plant City', zip: '33563', responseTime: '60-90 mins' },
  { slug: 'auburndale', name: 'Auburndale', zip: '33823', responseTime: '45-75 mins' },
  { slug: 'mulberry', name: 'Mulberry', zip: '33860', responseTime: '45-75 mins' },
  { slug: 'bartow', name: 'Bartow', zip: '33830', responseTime: '60-90 mins' },
  { slug: 'highland-city', name: 'Highland City', zip: '33846', responseTime: '30-60 mins' },
  { slug: 'dixieland-lakeland', name: 'Dixieland Lakeland', zip: '33803', responseTime: '30-45 mins' },
  { slug: 'lake-morton-lakeland', name: 'Lake Morton Lakeland', zip: '33801', responseTime: '30-45 mins' },
];

export interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const displayAreas = limit ? areas.slice(0, limit) : areas;
---

<section id="areas" class="py-16 sm:py-24 bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-2">Local Coverage Map</h2>
      <p class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal tracking-tight">
        Serving All Lakeland & Polk County Communities
      </p>
      <p class="mt-4 text-base text-brand-muted">
        Our local service vans are staged across Polk County for rapid dispatch. Select your neighborhood for local repair details.
      </p>
    </div>

    <div class={`grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 ${limit === 8 ? 'lg:grid-cols-4' : 'lg:grid-cols-5'} gap-5`}>
      {displayAreas.map((a) => (
        <div
          class="bg-white rounded-2xl p-5 border border-gray-200 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between group hover:border-brand-teal"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-gray-500 bg-gray-100 px-2 py-0.5 rounded">
                ZIP {a.zip}
              </span>
              <span class="text-[10px] font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">
                Available Today
              </span>
            </div>
            <h3 class="text-base font-heading font-bold text-brand-text mb-1 group-hover:text-brand-teal transition-colors">
              {a.name}
            </h3>
            <p class="text-[11px] text-brand-muted mb-4 flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-brand-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>Avg Response: <strong>{a.responseTime}</strong></span>
            </p>
          </div>
          <div class="text-[11px] font-bold text-brand-success flex items-center gap-1.5 pt-3 border-t border-gray-100">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Servicing Now</span>
          </div>
        </div>
      ))}
    </div>

    {limit && (
      <div class="text-center mt-12">
        <a href="/areas/" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white border-2 border-slate-100 text-brand-teal font-extrabold text-base hover:bg-brand-teal hover:border-brand-teal hover:text-white transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl group relative overflow-hidden">
          <span class="relative z-10 flex items-center">
            View All Service Areas
            <svg class="w-5 h-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </span>
        </a>
      </div>
    )}
  </div>
</section>
