---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const pageTitle = "Service Areas | Lakeland Repair";
const pageDescription = "We provide same-day appliance repair services across Polk County, FL, including Lakeland, Winter Haven, Bartow, and more.";

const areas = [
  { slug: 'downtown-lakeland', name: 'Downtown Lakeland', zip: '33801', responseTime: '30-60 mins', region: 'Central Lakeland', dedicatedTrucks: 3 },
  { slug: 'south-lakeland', name: 'South Lakeland', zip: '33813', responseTime: '45-60 mins', region: 'South Polk', dedicatedTrucks: 4 },
  { slug: 'dixieland-lakeland', name: 'Dixieland Lakeland', zip: '33803', responseTime: '30-45 mins', region: 'Central Lakeland', dedicatedTrucks: 2 },
  { slug: 'lake-morton-lakeland', name: 'Lake Morton Lakeland', zip: '33801', responseTime: '30-45 mins', region: 'Central Lakeland', dedicatedTrucks: 1 },
  { slug: 'winter-haven', name: 'Winter Haven', zip: '33880', responseTime: '45-90 mins', region: 'East Polk', dedicatedTrucks: 3 },
  { slug: 'auburndale', name: 'Auburndale', zip: '33823', responseTime: '45-75 mins', region: 'East Polk', dedicatedTrucks: 2 },
  { slug: 'haines-city', name: 'Haines City', zip: '33844', responseTime: '45-75 mins', region: 'East Polk', dedicatedTrucks: 2 },
  { slug: 'lake-wales', name: 'Lake Wales', zip: '33853', responseTime: '50-80 mins', region: 'East Polk', dedicatedTrucks: 2 },
  { slug: 'davenport', name: 'Davenport', zip: '33837', responseTime: '45-75 mins', region: 'Northeast Polk', dedicatedTrucks: 3 },
  { slug: 'polk-city', name: 'Polk City', zip: '33868', responseTime: '30-50 mins', region: 'North Polk', dedicatedTrucks: 2 },
  { slug: 'plant-city', name: 'Plant City', zip: '33563', responseTime: '60-90 mins', region: 'West Polk', dedicatedTrucks: 2 },
  { slug: 'mulberry', name: 'Mulberry', zip: '33860', responseTime: '45-75 mins', region: 'South Polk', dedicatedTrucks: 2 },
  { slug: 'bartow', name: 'Bartow', zip: '33830', responseTime: '60-90 mins', region: 'South Polk', dedicatedTrucks: 2 },
  { slug: 'highland-city', name: 'Highland City', zip: '33846', responseTime: '30-60 mins', region: 'South Polk', dedicatedTrucks: 1 },
];

const regions = [...new Set(areas.map(a => a.region))];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://appliancerepairlakelandfl.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Service Areas",
      "item": "https://appliancerepairlakelandfl.com/areas/"
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={breadcrumbSchema}>
  
  <PageHeader 
    badge="Local Mobile Units"
    title="Polk County Service Areas & Coverage" 
    description="Fast, local appliance repair right in your neighborhood. We dispatch dedicated service trucks stationed across Polk County for rapid same-day response." 
    showPhoneCta={true}
    secondaryBtnText="View All Services"
    secondaryBtnHref="/services/"
  />

  <section class="py-16 sm:py-20 bg-brand-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Countywide Service Dispatch Banner -->
      <div class="mb-14 p-6 sm:p-8 bg-gradient-to-r from-teal-950 via-brand-teal-dark to-slate-950 rounded-3xl border border-teal-600/50 shadow-2xl relative overflow-hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <!-- Ambient Decorative Glow -->
        <div class="absolute top-0 right-0 w-80 h-80 bg-brand-amber/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-60 h-60 bg-teal-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative z-10 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-800/90 border border-teal-500/50 text-brand-amber text-[11px] font-bold uppercase tracking-wider mb-2.5 backdrop-blur-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-success animate-pulse"></span>
            Polk County Master Dispatch
          </div>
          <h2 class="text-xl sm:text-2xl font-heading font-extrabold text-white mb-2 tracking-tight">
            Fast, Local Appliance Repair Across Polk County
          </h2>
          <p class="text-xs sm:text-sm text-teal-100/95 leading-relaxed font-normal">
            Our Lakeland-based service vans provide rapid same-day diagnostics throughout all local communities. Call our master dispatch desk for direct assistance or select your neighborhood below.
          </p>
        </div>

        <a 
          href="tel:+18632780714" 
          class="relative z-10 inline-flex items-center gap-2.5 px-7 py-4 rounded-full bg-brand-amber hover:bg-brand-amber-hover text-slate-900 font-extrabold text-xs uppercase tracking-wider shadow-xl shadow-amber-500/25 hover:shadow-amber-500/40 transform hover:-translate-y-0.5 transition-all shrink-0"
        >
          <svg class="w-4 h-4 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span>Call (863) 278-0714</span>
        </a>
      </div>
      
      {regions.map(region => (
        <div class="mb-16 last:mb-0">
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-brand-teal">{region}</h2>
            <div class="h-px bg-gray-300 flex-grow"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {areas.filter(a => a.region === region).map((a) => (
              <div
                class="bg-white rounded-3xl p-6 sm:p-7 border border-gray-200/90 shadow-sm hover:shadow-xl hover:border-brand-teal hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden"
              >
                <div class="absolute top-0 right-0 w-28 h-28 bg-brand-teal/5 rounded-bl-full -z-10 group-hover:scale-125 transition-transform duration-500"></div>
                
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-mono font-bold text-gray-600 bg-gray-100 px-3 py-1 rounded-lg">
                      ZIP {a.zip}
                    </span>
                    <span class="text-[10px] font-bold bg-emerald-100/80 text-emerald-800 px-3 py-1 rounded-full uppercase tracking-wider flex items-center gap-1.5 border border-emerald-200/50">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      Units: {a.dedicatedTrucks}
                    </span>
                  </div>
                  
                  <h3 class="text-xl font-heading font-extrabold text-brand-text mb-2 group-hover:text-brand-teal transition-colors">
                    {a.name}
                  </h3>
                  
                  <div class="bg-brand-surface/80 p-3.5 rounded-xl mt-4 flex items-center justify-between border border-gray-100">
                    <span class="text-xs text-brand-muted font-medium">Avg Response Time</span>
                    <span class="text-sm font-extrabold text-brand-teal font-heading">{a.responseTime}</span>
                  </div>
                </div>
                
                <div class="pt-5 mt-4 border-t border-gray-100 flex items-center justify-between">
                  <div class="text-xs font-bold text-brand-success flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span>Servicing Now</span>
                  </div>

                  <a 
                    href={`/areas/${a.slug}/`}
                    class="text-xs font-extrabold text-brand-teal hover:text-brand-amber flex items-center gap-1.5 group-hover:translate-x-1 transition-all"
                  >
                    <span>Area Details</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
      
    </div>
  </section>

  <CtaBanner />

</BaseLayout>
