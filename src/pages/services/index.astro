---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const pageTitle = "Our Appliance Repair Services | Lakeland Appliance Pro";
const pageDescription = "Comprehensive appliance repair services in Lakeland, FL. We fix refrigerators, washers, dryers, ovens, and more. Same-day service available.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <section class="bg-brand-teal-dark text-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Our Repair Services</h1>
      <p class="text-xl text-teal-100 max-w-3xl mx-auto leading-relaxed">
        We provide expert, same-day repair for all major household appliances. Find your appliance below to learn more about our specialized services.
      </p>
    </div>
  </section>

  <ServicesGrid />

  <CtaBanner />

</BaseLayout>
