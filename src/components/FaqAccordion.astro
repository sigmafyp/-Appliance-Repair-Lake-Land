---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  faqItems: FAQItem[];
  title?: string;
  subtitle?: string;
  isHomepage?: boolean;
}

const {
  faqItems = [],
  title = "Frequently Asked Questions",
  subtitle = "Have questions about our Polk County appliance repair services? Find clear answers below.",
  isHomepage = false
} = Astro.props;
---

<section class="py-16 sm:py-24 bg-white border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {title && (
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-2">Got Questions?</h2>
        <p class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal tracking-tight">
          {title}
        </p>
        <p class="mt-3 text-sm text-brand-muted">
          {subtitle}
        </p>
      </div>
    )}

    <div class="space-y-4" id="faq-accordion-group">
      {faqItems.map((item, idx) => (
        <div class="bg-brand-bg rounded-2xl border border-gray-200 overflow-hidden shadow-xs hover:border-teal-200/80 transition-colors faq-item">
          <button
            type="button"
            class="w-full px-6 py-5 text-left font-heading font-bold text-base text-brand-text flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-brand-teal/40 faq-trigger group cursor-pointer select-none"
            aria-expanded="false"
            aria-controls={`faq-answer-${idx}`}
          >
            <span class="group-hover:text-brand-teal transition-colors pr-4">{item.question}</span>
            <span class="w-8 h-8 rounded-full bg-white text-brand-teal border border-gray-100 flex items-center justify-center font-bold text-lg flex-shrink-0 shadow-xs transition-all duration-300 ease-out icon-arrow group-hover:scale-105">
              <svg class="w-4 h-4 transition-transform duration-300 ease-out transform icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          
          <div
            id={`faq-answer-${idx}`}
            class="faq-collapse border-t border-transparent"
          >
            <div class="faq-collapse-inner">
              <div class="px-6 pb-5 text-sm text-brand-muted leading-relaxed pt-3 bg-white border-t border-gray-100">
                <p>{item.answer}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupFaqAccordions() {
    const accordionItems = document.querySelectorAll('.faq-item');

    accordionItems.forEach((item) => {
      const trigger = item.querySelector('.faq-trigger') as HTMLButtonElement | null;
      const collapse = item.querySelector('.faq-collapse') as HTMLElement | null;
      const arrow = item.querySelector('.icon-arrow') as HTMLElement | null;
      const iconSvg = item.querySelector('.icon-svg') as SVGElement | null;

      if (trigger && collapse && arrow) {
        if (trigger.dataset.faqBound === 'true') return;
        trigger.dataset.faqBound = 'true';

        trigger.addEventListener('click', () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          const nextState = !isOpen;

          trigger.setAttribute('aria-expanded', nextState.toString());
          
          if (nextState) {
            collapse.classList.add('is-open');
            arrow.classList.add('bg-brand-amber', 'text-slate-900', 'border-amber-300');
            arrow.classList.remove('bg-white', 'text-brand-teal', 'border-gray-100');
            if (iconSvg) iconSvg.classList.add('rotate-45');
          } else {
            collapse.classList.remove('is-open');
            arrow.classList.remove('bg-brand-amber', 'text-slate-900', 'border-amber-300');
            arrow.classList.add('bg-white', 'text-brand-teal', 'border-gray-100');
            if (iconSvg) iconSvg.classList.remove('rotate-45');
          }
        });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupFaqAccordions);
  document.addEventListener('astro:page-load', setupFaqAccordions);
</script>
