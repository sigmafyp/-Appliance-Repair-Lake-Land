---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';

export async function getStaticPaths() {
  const areaEntries = await getCollection('areas');
  return areaEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, zip, responseTime, whyChooseUs, neighborhoods, faq } = entry.data;

const zipDisplay = Array.isArray(zip) ? zip.join(', ') : zip;

const pageTitle = `Appliance Repair in ${title}, FL | Same-Day Service | Lakeland Repair`;
const pageDescription = `Expert local appliance repair in ${title}, FL. Fast same-day service for refrigerators, washers, dryers, dishwashers, and ovens across ZIP ${zipDisplay}. Call (863) 555-0123.`;

// Get other service areas for cross-linking
const allAreas = await getCollection('areas');
const otherAreas = allAreas.filter((a) => a.id !== entry.id).slice(0, 6);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": `Lakeland Repair - ${title} Service Branch`,
  "telephone": "(863) 555-0123",
  "url": `https://appliancerepairlakelandfl.com/areas/${entry.id}/`,
  "areaServed": {
    "@type": "AdministrativeArea",
    "name": `${title}, FL`
  },
  "serviceArea": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": 28.0437,
      "longitude": -81.9560
    },
    "geoRadius": "40000"
  },
  "priceRange": "$$",
  "openingHours": "Mo,Tu,We,Th,Fr,Sa 07:00-19:00"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://appliancerepairlakelandfl.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Service Areas",
      "item": "https://appliancerepairlakelandfl.com/areas/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": `https://appliancerepairlakelandfl.com/areas/${entry.id}/`
    }
  ]
};

const coreServices = [
  { name: "Refrigerator & Freezer Repair", slug: "refrigerator-repair", icon: "🧊", desc: "Fixing Freon leaks, faulty compressors, and temperature control failures." },
  { name: "Washing Machine Repair", slug: "washer-repair", icon: "🧺", desc: "Stopping standing water, violent drum shaking, and faulty lid latches." },
  { name: "Clothes Dryer Repair", slug: "dryer-repair", icon: "🔥", desc: "Restoring heat, replacing broken belts, and clearing thermal safety fuses." },
  { name: "Oven, Stove & Range Repair", slug: "oven-range-repair", icon: "🍳", desc: "Igniter replacements, thermostat calibrations, and burner repairs." },
  { name: "Built-In Dishwasher Repair", slug: "dishwasher-repair", icon: "🍽️", desc: "Resolving drainage clogs, spray arm failures, and leak points." },
  { name: "Automatic Ice Maker Repair", slug: "ice-maker-repair", icon: "❄️", desc: "Restoring full cube production, unfreezing water lines, and replacing ejectors." },
];
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription}
  schema={[localBusinessSchema, faqSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-brand-teal-dark via-brand-teal to-brand-teal-dark text-white pt-10 pb-16 lg:pt-12 lg:pb-20 overflow-hidden border-b border-teal-800">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F2994A_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-800/90 border border-teal-600/50 text-brand-amber text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-brand-success animate-ping"></span>
            Active Mobile Techs in {title}
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white tracking-tight leading-tight">
            Fast, Trusted Appliance Repair in <span class="text-brand-amber">{title}, FL</span>
          </h1>

          <p class="text-base sm:text-lg text-teal-100/95 leading-relaxed font-normal">
            When household appliances break in {title}, you need prompt, honest service from licensed local tradespeople. We dispatch fully stocked repair vans throughout ZIP code(s) <strong class="text-white font-mono">{zipDisplay}</strong> for same-day diagnostics and upfront flat-rate quotes.
          </p>

          <!-- Response time card -->
          <div class="p-4 rounded-xl bg-teal-900/80 border border-teal-700/80 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-brand-amber/20 text-brand-amber flex items-center justify-center font-bold">
                ⚡
              </div>
              <div>
                <span class="text-xs text-teal-200 block uppercase font-bold tracking-wider">Average Arrival Window</span>
                <span class="text-lg font-heading font-extrabold text-white">{responseTime} in {title}</span>
              </div>
            </div>
            <div class="text-right">
              <span class="text-xs text-emerald-400 font-semibold block">Same-Day Slots Available</span>
              <span class="text-xs text-teal-300">Mon - Sat: 7am – 7pm</span>
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a
              href="tel:8635550123"
              class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-brand-amber text-slate-900 font-extrabold text-base hover:bg-brand-amber-hover transition-all transform hover:-translate-y-0.5 shadow-xl group text-center"
            >
              <svg class="w-5 h-5 mr-2.5 text-slate-900 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Call (863) 555-0123 Now
            </a>

            <a
              href="/services/"
              class="inline-flex items-center justify-center px-7 py-4 rounded-full bg-teal-800/80 hover:bg-brand-teal-light border border-teal-600/60 text-white font-bold text-base transition-all text-center"
            >
              View All Services
            </a>
          </div>

          <!-- Trust bullets -->
          <div class="pt-4 grid grid-cols-3 gap-2 text-xs text-teal-200/90 border-t border-teal-800">
            <div class="flex items-center gap-1.5">
              <span class="text-brand-success font-bold">✓</span> 90-Day Warranty
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-brand-success font-bold">✓</span> Genuine OEM Parts
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-brand-success font-bold">✓</span> Licensed & Insured
            </div>
          </div>
        </div>

        <!-- Neighborhoods Sidebar Card -->
        <div class="lg:col-span-5">
          <div class="bg-white rounded-3xl p-7 sm:p-8 text-brand-text shadow-2xl border border-gray-100 relative">
            <span class="text-xs font-bold uppercase tracking-widest text-brand-amber block mb-2">Local Neighborhood Coverage</span>
            <h2 class="text-2xl font-heading font-extrabold text-brand-teal mb-4">
              Where We Repair in {title}
            </h2>
            <p class="text-xs text-brand-muted mb-5 leading-relaxed">
              Our service coordinators route licensed technicians throughout {title} and surrounding communities daily:
            </p>

            <ul class="space-y-2.5 mb-6">
              {neighborhoods.map((n) => (
                <li class="flex items-start gap-2.5 text-xs sm:text-sm font-medium text-gray-700 bg-brand-surface px-3.5 py-2.5 rounded-xl border border-gray-100">
                  <svg class="w-4 h-4 text-brand-teal flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span>{n}</span>
                </li>
              ))}
            </ul>

            <div class="bg-teal-50 border border-teal-100 rounded-2xl p-4 text-center">
              <span class="text-xs text-brand-teal-dark font-bold block mb-1">Serving ZIP Codes:</span>
              <span class="font-mono text-sm font-extrabold text-brand-teal tracking-wide">{zipDisplay}</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Choose Us in This City -->
  <section class="py-16 sm:py-20 bg-white border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="text-brand-amber font-bold tracking-widest uppercase text-xs">Community Focused Service</span>
      <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal">
        Why {title} Homeowners Rely on Lakeland Repair
      </h2>
      <p class="text-base sm:text-lg text-brand-muted leading-relaxed max-w-3xl mx-auto">
        {whyChooseUs}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 text-left">
        <div class="p-6 rounded-2xl bg-brand-surface border border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-teal-100 text-brand-teal flex items-center justify-center font-bold text-lg mb-4">
            🛠️
          </div>
          <h3 class="font-heading font-bold text-brand-teal-dark mb-2">Truck-Stocked Parts</h3>
          <p class="text-xs text-brand-muted leading-relaxed">
            Our vans carry over 500 factory components to complete over 85% of repairs during the very first service visit.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-brand-surface border border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-brand-amber flex items-center justify-center font-bold text-lg mb-4">
            📋
          </div>
          <h3 class="font-heading font-bold text-brand-teal-dark mb-2">Waived Diagnostic Fee</h3>
          <p class="text-xs text-brand-muted leading-relaxed">
            When you approve the repair, our comprehensive diagnostics fee is applied 100% toward your final bill.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-brand-surface border border-gray-100">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-brand-success flex items-center justify-center font-bold text-lg mb-4">
            🛡️
          </div>
          <h3 class="font-heading font-bold text-brand-teal-dark mb-2">90-Day Guarantee</h3>
          <p class="text-xs text-brand-muted leading-relaxed">
            Every installed part and labor hour is backed by our rock-solid 90-day guarantee for your complete peace of mind.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services in this Area -->
  <section class="py-16 sm:py-20 bg-brand-surface border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-brand-amber font-bold tracking-widest uppercase text-xs">Full Diagnostic Capabilities</span>
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal mt-2">
          Appliances We Service in {title}, FL
        </h2>
        <p class="text-sm sm:text-base text-brand-muted mt-3">
          Our certified technicians service all major kitchen and laundry appliances across Polk County.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {coreServices.map((service) => (
          <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between group hover:border-brand-teal">
            <div>
              <div class="text-3xl mb-3">{service.icon}</div>
              <h3 class="text-lg font-heading font-bold text-brand-text mb-2">
                <a href={`/services/${service.slug}/`} class="hover:text-brand-teal transition-colors">
                  {service.name}
                </a>
              </h3>
              <p class="text-xs text-brand-muted leading-relaxed mb-6">
                {service.desc}
              </p>
            </div>

            <div class="pt-4 border-t border-gray-100">
              <a 
                href="tel:8635550123"
                class="w-full text-center py-2.5 px-3 rounded-xl bg-brand-teal-dark hover:bg-slate-950 text-white font-bold text-xs shadow-sm transition-colors flex items-center justify-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 text-brand-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                Call Now: (863) 555-0123
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Local Area FAQ -->
  <section class="py-16 sm:py-20 bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-brand-amber font-bold tracking-widest uppercase text-xs">Helpful Information</span>
        <h2 class="text-3xl font-heading font-extrabold text-brand-teal mt-2">
          {title} Appliance Repair FAQ
        </h2>
      </div>

      <FaqAccordion faqItems={faq} />
    </div>
  </section>

  <!-- Nearby Service Areas -->
  <section class="py-12 bg-brand-surface border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
        <h3 class="text-base font-heading font-bold text-brand-teal-dark">
          Other Service Areas Near {title}
        </h3>
        <a href="/areas/" class="text-xs font-bold text-brand-teal hover:text-brand-amber flex items-center gap-1">
          View All Polk County Service Areas &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {otherAreas.map((area) => (
          <a
            href={`/areas/${area.id}/`}
            class="p-3 bg-white rounded-xl border border-gray-200 text-center hover:border-brand-teal hover:shadow-md transition-all group"
          >
            <span class="text-xs font-bold text-brand-text group-hover:text-brand-teal block mb-1">
              {area.data.title}
            </span>
            <span class="text-[10px] text-brand-muted block">
              Avg {area.data.responseTime}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <CtaBanner 
    headline={`Need Urgent Appliance Repair in ${title}?`}
    subhead={`Our local ${title} mobile service vans are standing by. Call our direct dispatch desk now for immediate availability and upfront pricing.`}
    secondaryText="View All Areas"
    secondaryHref="/areas/"
  />
</BaseLayout>
