---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';

export async function getStaticPaths() {
  const areaEntries = await getCollection('areas');
  return areaEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, responseTime, zip, whyChooseUs, neighborhoods, faq } = entry.data;

const formattedZip = Array.isArray(zip) ? zip.join(', ') : zip;

const pageTitle = `Appliance Repair in ${title}, FL (${formattedZip}) | Lakeland Appliance Pro`;
const pageDescription = `Same-day appliance repair services in ${title}, FL. Serving zip codes ${formattedZip} with response times of ${responseTime}. Licensed & insured technicians.`;

const allServices = await getCollection('services');

const areaSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Appliance Repair in ${title}`,
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "Lakeland Appliance Pro"
  },
  "areaServed": `${title}, FL (${formattedZip})`,
  "description": whyChooseUs
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={areaSchema}>
  
  <!-- Breadcrumb -->
  <Breadcrumb items={[
    { name: 'Service Areas', href: '/#areas' },
    { name: title }
  ]} />

  <!-- Area Hero -->
  <section class="bg-brand-teal text-white py-14 lg:py-20 relative overflow-hidden border-b border-teal-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-5">
        
        <div class="flex flex-wrap items-center gap-3">
          <span class="px-3.5 py-1 rounded-full bg-brand-amber text-slate-900 text-xs font-extrabold uppercase">
            ZIP Code Coverage: {formattedZip}
          </span>
          <span class="px-3.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-xs font-bold">
            ⚡ Avg Response Time: {responseTime}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white tracking-tight leading-tight">
          Appliance Repair in {title}, FL
        </h1>

        <p class="text-lg text-teal-100/90 leading-relaxed">
          {whyChooseUs}
        </p>

        <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="tel:8635550123"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-brand-amber text-slate-900 font-extrabold text-base hover:bg-brand-amber-hover transition-all shadow-xl group"
          >
            <svg class="w-5 h-5 mr-2 text-slate-900 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Call {title} Dispatch: (863) 555-0123
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Choose Us in Area -->
  <section class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber">Local Expertise</h2>
          <h3 class="text-3xl font-heading font-extrabold text-brand-teal">
            Why {title} Homeowners Choose Us
          </h3>
          <p class="text-sm text-brand-muted leading-relaxed">
            {whyChooseUs}
          </p>
          <div class="pt-4 grid grid-cols-2 gap-4 text-xs font-bold text-brand-teal">
            <div class="p-4 rounded-xl bg-brand-bg border border-gray-200">
              ✓ Local Technician Staged Nearby
            </div>
            <div class="p-4 rounded-xl bg-brand-bg border border-gray-200">
              ✓ Fully Stocked Service Truck
            </div>
            <div class="p-4 rounded-xl bg-brand-bg border border-gray-200">
              ✓ Upfront Flat-Rate Estimates
            </div>
            <div class="p-4 rounded-xl bg-brand-bg border border-gray-200">
              ✓ 90-Day Parts & Labor Warranty
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-brand-surface p-8 rounded-2xl border border-gray-200 shadow-md space-y-4">
          <h4 class="font-heading font-bold text-lg text-brand-teal">
            Dispatch Status for {title}
          </h4>
          <div class="space-y-3 text-xs text-brand-muted">
            <div class="flex justify-between items-center py-2 border-b border-gray-200">
              <span>Primary Zip Codes:</span>
              <span class="font-bold text-brand-text">{formattedZip}</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-gray-200">
              <span>Estimated Arrival:</span>
              <span class="font-bold text-brand-amber">{responseTime}</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-gray-200">
              <span>Today's Availability:</span>
              <span class="font-bold text-brand-success">Same-Day Slots Open</span>
            </div>
            <div class="flex justify-between items-center py-2">
              <span>Dispatch Line:</span>
              <a href="tel:8635550123" class="font-bold text-brand-teal hover:underline">(863) 555-0123</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- All 14 Services Available in Area -->
  <section class="py-16 bg-brand-bg border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-2">Complete Local Coverage</h2>
        <h3 class="text-3xl font-heading font-extrabold text-brand-teal">
          Appliance Services Available in {title}
        </h3>
        <p class="mt-2 text-sm text-brand-muted">
          All 14 specialized repair services are fully available for residential and commercial customers in {title}.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {allServices.map((s) => (
          <a
            href={`/services/${s.slug}`}
            class="p-4 rounded-xl bg-white border border-gray-200 shadow-xs hover:shadow-md transition-all flex items-center space-x-3 group"
          >
            <span class="text-2xl">{s.data.icon}</span>
            <div>
              <h4 class="text-xs font-heading font-bold text-brand-text group-hover:text-brand-teal transition-colors">
                {s.data.title}
              </h4>
              <span class="text-[10px] text-brand-amber font-semibold">Available in {title} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Neighborhoods We Cover -->
  <section class="py-14 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-xl font-heading font-extrabold text-brand-teal mb-6">
        Neighborhoods & Corridors Covered in {title}
      </h3>
      <div class="flex flex-wrap gap-3">
        {neighborhoods.map((n) => (
          <span class="px-4 py-2 rounded-full bg-teal-50 text-brand-teal text-xs font-bold border border-teal-100">
            📍 {n}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Extra Markdown Content -->
  <section class="py-8 bg-brand-surface border-b border-gray-200 prose max-w-4xl mx-auto px-4 text-sm text-brand-muted">
    <Content />
  </section>

  <!-- Area Specific FAQ -->
  <FaqAccordion faqItems={faq} title={`${title} Service FAQs`} />

  <!-- Final CTA Banner -->
  <CtaBanner
    headline={`Need Fast Appliance Repair in ${title}?`}
    subhead={`Our local technician can be at your ${title} home within ${responseTime}. Call (863) 555-0123.`}
  />

</BaseLayout>
