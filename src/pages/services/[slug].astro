---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';

export async function getStaticPaths() {
  const serviceEntries = await getCollection('services');
  return serviceEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, shortDescription, icon, whatWeFix, signsYouNeedRepair, brandsServiced, faq } = entry.data;

const pageTitle = `${title} Repair in Lakeland, FL | Lakeland Appliance Pro`;
const pageDescription = shortDescription;

// Get 3 related services for bottom links
const allServices = await getCollection('services');
const relatedServices = allServices
  .filter((s) => s.slug !== entry.slug)
  .slice(0, 3);

// Service Schema markup
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${title} Repair`,
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "Lakeland Appliance Pro"
  },
  "areaServed": "Lakeland & Polk County, FL",
  "description": shortDescription
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={[serviceSchema, faqSchema]}>
  
  <!-- Breadcrumb -->
  <Breadcrumb items={[
    { name: 'Services', href: '/#services' },
    { name: `${title} Repair` }
  ]} />

  <!-- Service Specific Hero -->
  <section class="bg-brand-teal text-white py-14 lg:py-20 relative overflow-hidden border-b border-teal-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-5">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-teal-800 text-brand-amber text-xs font-bold uppercase tracking-wider">
            <span>{icon} Certified Polk County Trade Specialists</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white tracking-tight leading-tight">
            {title} Repair in Lakeland, FL
          </h1>

          <p class="text-lg text-teal-100/90 leading-relaxed max-w-2xl">
            {shortDescription}
          </p>

          <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="tel:8635550123"
              class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-brand-amber text-slate-900 font-extrabold text-base hover:bg-brand-amber-hover transition-all shadow-xl group"
            >
              <svg class="w-5 h-5 mr-2 text-slate-900 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Call (863) 555-0123 Now
            </a>
            <div class="text-xs text-teal-200 flex items-center justify-center sm:justify-start gap-3">
              <span>✓ Same-Day Available</span>
              <span>•</span>
              <span>✓ Upfront Pricing</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-4 bg-teal-900/80 p-6 rounded-2xl border border-teal-700/60 shadow-xl space-y-4">
          <h3 class="text-base font-heading font-bold text-brand-amber uppercase tracking-wider">
            Quick Service Facts
          </h3>
          <ul class="text-xs space-y-2.5 text-teal-100">
            <li class="flex items-center justify-between py-1 border-b border-teal-800">
              <span class="text-teal-300">Coverage:</span>
              <span class="font-bold text-white">Lakeland & Polk County</span>
            </li>
            <li class="flex items-center justify-between py-1 border-b border-teal-800">
              <span class="text-teal-300">Parts Used:</span>
              <span class="font-bold text-white">100% Genuine OEM</span>
            </li>
            <li class="flex items-center justify-between py-1 border-b border-teal-800">
              <span class="text-teal-300">Warranty:</span>
              <span class="font-bold text-white">90-Day Parts & Labor</span>
            </li>
            <li class="flex items-center justify-between py-1">
              <span class="text-teal-300">Dispatch Window:</span>
              <span class="font-bold text-brand-amber">Same-Day Priority</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- What We Fix Section -->
  <section class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-2">Comprehensive Diagnostics</h2>
        <h3 class="text-3xl font-heading font-extrabold text-brand-teal">
          What We Fix for {title} Units
        </h3>
        <p class="mt-2 text-sm text-brand-muted">
          Our certified technicians diagnose and resolve all common hardware failures on {title.toLowerCase()} models.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {whatWeFix.map((item) => (
          <div class="bg-brand-bg p-5 rounded-xl border border-gray-200 flex items-start space-x-3">
            <span class="text-brand-success font-bold text-lg leading-none mt-0.5">✓</span>
            <span class="text-xs font-medium text-brand-text leading-relaxed">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reused Process Steps Component -->
  <ProcessSteps />

  <!-- Signs You Need Repair Section -->
  <section class="py-16 bg-brand-bg border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-2">Warning Symptoms</h2>
        <h3 class="text-3xl font-heading font-extrabold text-brand-teal">
          Signs Your {title} Needs Immediate Service
        </h3>
        <p class="mt-2 text-sm text-brand-muted">
          Catching these warning signs early prevents permanent component burnout and costly water/electrical damage.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {signsYouNeedRepair.map((sign) => (
          <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="w-8 h-8 rounded-full bg-amber-100 text-brand-amber font-bold flex items-center justify-center mb-4 text-sm">
                !
              </div>
              <h4 class="font-heading font-bold text-base text-brand-text mb-2">{sign.title}</h4>
              <p class="text-xs text-brand-muted leading-relaxed">{sign.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brands We Service -->
  <section class="py-12 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h3 class="text-xs font-bold uppercase tracking-widest text-brand-muted mb-6">
        {title} Brands Serviced Across Polk County
      </h3>
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8">
        {brandsServiced.map((brand) => (
          <div class="px-5 py-2.5 rounded-xl bg-brand-bg border border-gray-200 font-heading font-bold text-sm text-brand-teal shadow-xs">
            {brand}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Markdown Render (if any extra text) -->
  <section class="py-12 bg-brand-surface border-b border-gray-200 prose max-w-4xl mx-auto px-4 text-sm text-brand-muted">
    <Content />
  </section>

  <!-- FAQ Accordion -->
  <FaqAccordion faqItems={faq} title={`${title} Repair FAQs`} />

  <!-- Related Services Row -->
  <section class="py-16 bg-brand-bg border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-xl font-heading font-extrabold text-brand-teal mb-8">
        Other Home Appliance Repairs We Provide
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedServices.map((rel) => (
          <a
            href={`/services/${rel.slug}`}
            class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-all group"
          >
            <div class="text-2xl mb-2">{rel.data.icon}</div>
            <h4 class="font-heading font-bold text-base text-brand-text group-hover:text-brand-teal transition-colors mb-1">
              {rel.data.title} Repair
            </h4>
            <p class="text-xs text-brand-muted line-clamp-2">{rel.data.shortDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA Banner -->
  <CtaBanner
    headline={`Need Urgent ${title} Repair in Lakeland?`}
    subhead={`Call our local dispatch desk now at (863) 555-0123 for same-day service.`}
  />

</BaseLayout>
