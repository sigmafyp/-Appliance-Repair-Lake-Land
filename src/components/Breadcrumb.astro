---
export interface BreadcrumbItem {
  name: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="bg-teal-900/30 border-b border-teal-800/40 py-3 px-4 text-xs font-medium text-teal-200">
  <div class="max-w-7xl mx-auto flex items-center space-x-2 overflow-x-auto whitespace-nowrap">
    <a href="/" class="hover:text-brand-amber transition-colors flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      <span>Home</span>
    </a>
    
    {items.map((item) => (
      <div class="flex items-center space-x-2">
        <span class="text-teal-500">/</span>
        {item.href ? (
          <a href={item.href} class="hover:text-brand-amber transition-colors">
            {item.name}
          </a>
        ) : (
          <span class="text-brand-amber font-semibold">{item.name}</span>
        )}
      </div>
    ))}
  </div>
</nav>
