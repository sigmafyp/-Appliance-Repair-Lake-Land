---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const pageTitle = "Our Appliance Repair Services | Lakeland Repair";
const pageDescription = "Comprehensive appliance repair services in Lakeland, FL. We fix refrigerators, washers, dryers, ovens, and more. Same-day service available.";

import ServicesGrid from '../../components/ServicesGrid.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://appliancerepairlakelandfl.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Appliance Services",
      "item": "https://appliancerepairlakelandfl.com/services/"
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={breadcrumbSchema}>
  

  <PageHeader 
    badge="Certified Trade Craftsmanship"
    title="Comprehensive Appliance Repair Services" 
    description="Same-day diagnostic and repair solutions for all major home and commercial appliances across Lakeland & Polk County." 
    showPhoneCta={true}
    secondaryBtnText="View Service Areas"
    secondaryBtnHref="/areas/"
  />

  <ServicesGrid hideHeader={true} />

  <CtaBanner />

</BaseLayout>
