---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBanner from '../../components/CtaBanner.astro';

export async function getStaticPaths() {
  const serviceEntries = await getCollection('services');
  return serviceEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { 
  title, 
  shortDescription, 
  icon, 
  whatWeFix, 
  signsYouNeedRepair, 
  brandsServiced, 
  faq,
  comprehensiveCoverage,
  diagnosticGuide,
  technicalStandards,
  advantages
} = entry.data;

// Normalize title to avoid duplicate "Repair Repair"
const repairTitle = title.endsWith(" Repair") ? title : `${title} Repair`;
const applianceName = title.replace(/\s+Repair$/i, "");

const pageTitle = `${repairTitle} in Lakeland, FL | Lakeland Appliance Pro`;
const pageDescription = shortDescription;

// Get 3 related services for bottom links
const allServices = await getCollection('services');
const relatedServices = allServices
  .filter((s) => s.id !== entry.id)
  .slice(0, 3);

// Service Schema markup
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": repairTitle,
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": "Lakeland Appliance Pro"
  },
  "areaServed": "Lakeland & Polk County, FL",
  "description": shortDescription
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={[serviceSchema, faqSchema]}>
  
  <!-- Service Specific Hero -->
  <section class="bg-brand-teal text-white py-14 lg:py-24 relative overflow-hidden border-b border-teal-800">
    <!-- Premium background gradients -->
    <div class="absolute inset-0 bg-gradient-to-br from-brand-teal-dark to-brand-teal z-0"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-teal-light/20 rounded-full blur-3xl -mr-32 -mt-32 pointer-events-none z-0"></div>
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-brand-amber/10 rounded-full blur-3xl -ml-16 -mb-16 pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start pt-6 lg:pt-10">
        
        <div class="lg:col-span-8 space-y-6">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 rounded-full bg-teal-900/80 border border-teal-700/50 text-brand-amber text-xs font-bold uppercase tracking-widest shadow-sm">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
              </svg>
              <span>Lakeland {repairTitle} Specialists</span>
            </span>
            <span class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-xs font-bold shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>EPA Certified Technicians</span>
            </span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-white tracking-tight leading-tight drop-shadow-sm">
            Precision {repairTitle} Across Polk County
          </h1>

          <p class="text-xl text-teal-50/90 leading-relaxed max-w-2xl font-light">
            {shortDescription}
          </p>

          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="tel:8635550123"
              class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-gradient-to-r from-brand-amber to-amber-500 text-slate-900 font-extrabold text-base hover:from-amber-400 hover:to-amber-600 transition-all shadow-[0_0_20px_rgba(245,158,11,0.3)] hover:shadow-[0_0_30px_rgba(245,158,11,0.5)] hover:-translate-y-0.5 group"
            >
              <svg class="w-5 h-5 mr-2 text-slate-900 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Call (863) 555-0123 Now
            </a>
          </div>
        </div>

        <!-- Trust Stats Panel -->
        <div class="lg:col-span-4 bg-white/5 backdrop-blur-xl p-8 rounded-3xl border border-white/10 shadow-2xl relative overflow-hidden group hover:border-brand-amber/30 transition-colors">
          <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          <div class="space-y-6 relative z-10">
            
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-teal-800/50 flex items-center justify-center border border-teal-600/30">
                <span class="text-2xl">⏱️</span>
              </div>
              <div>
                <div class="text-2xl font-extrabold text-white">1-3 Hrs</div>
                <div class="text-xs text-teal-200 font-medium tracking-wide uppercase">Avg Response in Lakeland</div>
              </div>
            </div>

            <div class="w-full h-px bg-teal-800/50"></div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-teal-800/50 flex items-center justify-center border border-teal-600/30">
                <span class="text-2xl">🏆</span>
              </div>
              <div>
                <div class="text-2xl font-extrabold text-white">98%</div>
                <div class="text-xs text-teal-200 font-medium tracking-wide uppercase">First-Visit Resolution Rate</div>
              </div>
            </div>

            <div class="w-full h-px bg-teal-800/50"></div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-teal-800/50 flex items-center justify-center border border-teal-600/30">
                <span class="text-2xl">🛡️</span>
              </div>
              <div>
                <div class="text-2xl font-extrabold text-white">90 Days</div>
                <div class="text-xs text-teal-200 font-medium tracking-wide uppercase">Full Parts & Labor Warranty</div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Quick Trust Feature Bar -->
  <section class="bg-brand-teal-dark border-b border-teal-900 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center divide-x divide-teal-800/50">
        <div class="px-2">
          <div class="text-brand-amber text-lg mb-1">🚨</div>
          <div class="text-sm font-bold text-white mb-0.5">Urgent Service</div>
          <div class="text-[10px] text-teal-300">Same-Day Local Dispatch</div>
        </div>
        <div class="px-2">
          <div class="text-brand-amber text-lg mb-1">✅</div>
          <div class="text-sm font-bold text-white mb-0.5">EPA Certified</div>
          <div class="text-[10px] text-teal-300">Safe Sealed System Handling</div>
        </div>
        <div class="px-2">
          <div class="text-brand-amber text-lg mb-1">🚚</div>
          <div class="text-sm font-bold text-white mb-0.5">Stocked Units</div>
          <div class="text-[10px] text-teal-300">Genuine Factory Replacement Parts</div>
        </div>
        <div class="px-2">
          <div class="text-brand-amber text-lg mb-1">💵</div>
          <div class="text-sm font-bold text-white mb-0.5">Honest Pricing</div>
          <div class="text-[10px] text-teal-300">Upfront Estimates Guaranteed</div>
        </div>
      </div>
    </div>
  </section>

  {comprehensiveCoverage && comprehensiveCoverage.length > 0 && (
    <section class="py-20 bg-brand-surface border-b border-gray-200 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-3 flex items-center justify-center gap-3">
            <span class="w-8 h-px bg-brand-amber/30"></span>
            Comprehensive Coverage
            <span class="w-8 h-px bg-brand-amber/30"></span>
          </h2>
          <h3 class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal mb-4">
            All {applianceName} Makes, Models & Configurations
          </h3>
          <p class="text-brand-muted leading-relaxed text-base">
            From classic household models to custom built-in and smart appliances, our master technicians have the specialized equipment to repair every style.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-8">
          {comprehensiveCoverage.map((item: any) => (
            <div class="flex-1 w-full sm:min-w-[300px] max-w-3xl bg-white p-8 rounded-3xl shadow-md border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
              <h4 class="text-xl font-heading font-bold text-brand-teal mb-3 group-hover:text-brand-teal-dark transition-colors">{item.title}</h4>
              <p class="text-sm text-brand-muted leading-relaxed mb-5">{item.description}</p>
              {item.bullets && item.bullets.length > 0 && (
                <ul class="space-y-2">
                  {item.bullets.map((bullet: string) => (
                    <li class="flex items-start text-xs text-brand-text">
                      <span class="text-brand-success mr-2 font-bold leading-none mt-0.5">✓</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {diagnosticGuide && diagnosticGuide.length > 0 && (
    <section class="py-24 bg-white border-b border-gray-100 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-16 items-start">
          <div class="lg:w-1/3 sticky top-28">
            <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-3">Diagnostic Guide</h2>
            <h3 class="text-3xl font-heading font-extrabold text-brand-teal mb-4">
              Common {applianceName} Symptoms We Solve Daily
            </h3>
            <p class="text-sm text-brand-muted leading-relaxed mb-6">
              Don't guess what is wrong with your {applianceName.toLowerCase()}. Here are the most frequent failures in Polk County homes and exactly how our expert technicians resolve them.
            </p>
            <div class="p-6 bg-brand-surface rounded-2xl border border-brand-teal/10">
              <p class="text-xs font-bold text-brand-teal mb-2">Need immediate help?</p>
              <a href="tel:8635550123" class="text-lg font-bold text-brand-amber hover:underline">(863) 555-0123</a>
            </div>
          </div>
          
          <div class="lg:w-2/3 space-y-8">
            {diagnosticGuide.map((guide: any) => (
              <div class="bg-brand-surface/30 p-8 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="inline-block px-3 py-1 bg-white border border-gray-200 text-brand-text text-xs font-bold rounded-full mb-4 shadow-xs">
                  Symptom: {guide.symptom}
                </div>
                <h4 class="text-xl font-heading font-bold text-brand-teal mb-3">{guide.title}</h4>
                <p class="text-sm text-brand-muted leading-relaxed mb-5">{guide.description}</p>
                <div class="bg-white p-5 rounded-xl border border-brand-teal/10 border-l-4 border-l-brand-teal">
                  <span class="text-xs font-bold uppercase tracking-widest text-brand-teal block mb-1">Lakeland Repair Precision Fix:</span>
                  <p class="text-sm text-brand-text">{guide.solution}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {technicalStandards && technicalStandards.length > 0 && (
    <section class="py-24 bg-brand-teal text-white relative overflow-hidden border-b border-teal-900">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F59E0B_1px,transparent_1px)] [background-size:30px_30px] pointer-events-none"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-3 flex items-center justify-center gap-3">
            <span class="w-8 h-px bg-brand-amber/30"></span>
            Master Technical Standard
            <span class="w-8 h-px bg-brand-amber/30"></span>
          </h2>
          <h3 class="text-3xl sm:text-4xl font-heading font-extrabold text-white mb-4">
            How We Diagnose & Repair Complex Systems
          </h3>
          <p class="text-teal-100 leading-relaxed text-base">
            Modern {applianceName.toLowerCase()}s are sophisticated machines combining mechanical loops, digital inverter electronics, and micro-sensors. Simple part swapping won't solve underlying issues.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-8">
          {technicalStandards.map((std: any, idx: number) => (
            <div class="flex-1 w-full sm:min-w-[300px] max-w-lg bg-teal-900/40 backdrop-blur-sm p-8 rounded-3xl border border-teal-700/50 hover:bg-teal-800/40 transition-colors">
              <div class="w-12 h-12 bg-teal-800 text-brand-amber rounded-2xl flex items-center justify-center font-bold text-xl mb-6 shadow-inner border border-teal-600/30">
                0{idx + 1}
              </div>
              <h4 class="text-lg font-heading font-bold text-white mb-3">{std.title}</h4>
              <p class="text-sm text-teal-100/80 leading-relaxed">{std.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {advantages && advantages.length > 0 && (
    <section class="py-20 bg-brand-surface border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-12 items-center">
          <div class="lg:w-1/2">
            <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-2">The Lakeland Advantage</h2>
            <h3 class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal mb-6">
              Why Polk County Chooses Us for {repairTitle}
            </h3>
            <p class="text-brand-muted mb-8 leading-relaxed">
              When you call Lakeland Repair, you are connecting directly with dedicated local appliance repair professionals committed to punctuality, honesty, and master craftsmanship.
            </p>
            <div class="flex flex-wrap gap-6">
              {advantages.map((adv: any) => (
                <div class="flex-1 min-w-[240px] bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:border-brand-amber/30 transition-colors">
                  <h4 class="font-heading font-bold text-brand-text mb-2 text-sm">{adv.title}</h4>
                  <p class="text-xs text-brand-muted leading-relaxed">{adv.description}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="lg:w-1/2 w-full h-[500px] bg-white rounded-3xl shadow-xl overflow-hidden relative border border-gray-100 flex items-center justify-center group">
             <div class="absolute inset-0 bg-brand-teal/5"></div>
             <div class="relative z-10 w-32 h-32 bg-white rounded-full flex items-center justify-center shadow-2xl border border-brand-teal/10 group-hover:scale-110 transition-transform duration-500">
               <span class="text-6xl">{icon}</span>
             </div>
             <!-- Decorative elements -->
             <div class="absolute top-10 left-10 w-20 h-20 bg-brand-amber/10 rounded-full blur-xl"></div>
             <div class="absolute bottom-10 right-10 w-32 h-32 bg-brand-teal/10 rounded-full blur-2xl"></div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Reused Process Steps Component -->
  <ProcessSteps />

  <!-- Homeowner Guide (DIY vs Pro) -->
  <section class="py-20 bg-white border-b border-gray-100 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-3 flex items-center justify-center gap-3">
          <span class="w-8 h-px bg-brand-amber/30"></span>
          Homeowner Guide
          <span class="w-8 h-px bg-brand-amber/30"></span>
        </h2>
        <h3 class="text-3xl font-heading font-extrabold text-brand-teal mb-4">
          DIY {applianceName} Maintenance vs. When to Call a Pro
        </h3>
        <p class="text-brand-muted leading-relaxed text-sm">
          Regular maintenance keeps your {applianceName.toLowerCase()} energy efficient. However, high-voltage circuitry and pressurized systems require certified technicians.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- DIY Side -->
        <div class="bg-brand-surface p-8 sm:p-10 rounded-3xl border border-gray-200 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-xl mb-6 shadow-sm border border-gray-100">
            🧹
          </div>
          <h4 class="text-xl font-heading font-bold text-brand-text mb-6">Safe for Homeowners (DIY)</h4>
          <ul class="space-y-5">
            <li class="flex gap-4">
              <span class="text-brand-success text-lg mt-0.5">✓</span>
              <div>
                <strong class="block text-sm text-brand-text mb-1">Exterior Cleaning & Wiping</strong>
                <span class="text-xs text-brand-muted">Keep control panels clean and free of excessive moisture using a damp cloth.</span>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="text-brand-success text-lg mt-0.5">✓</span>
              <div>
                <strong class="block text-sm text-brand-text mb-1">Checking Power & Plugs</strong>
                <span class="text-xs text-brand-muted">Verify the unit is plugged in securely and the household breaker hasn't tripped before assuming failure.</span>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="text-brand-success text-lg mt-0.5">✓</span>
              <div>
                <strong class="block text-sm text-brand-text mb-1">Leveling the Appliance</strong>
                <span class="text-xs text-brand-muted">Ensure the appliance sits perfectly level on the floor to prevent vibrations and drainage issues.</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Pro Side -->
        <div class="bg-red-50/50 p-8 sm:p-10 rounded-3xl border border-red-100 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-xl mb-6 shadow-sm border border-red-100">
            ⚠️
          </div>
          <h4 class="text-xl font-heading font-bold text-red-900 mb-6">Requires a Certified Technician</h4>
          <ul class="space-y-5">
            <li class="flex gap-4">
              <span class="text-red-500 text-lg mt-0.5">✕</span>
              <div>
                <strong class="block text-sm text-red-900 mb-1">Internal Electrical Components</strong>
                <span class="text-xs text-red-800/80">Diagnosing micro-relay burns and control boards without shorting sensitive circuitry.</span>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="text-red-500 text-lg mt-0.5">✕</span>
              <div>
                <strong class="block text-sm text-red-900 mb-1">Motors, Pumps & Sealed Systems</strong>
                <span class="text-xs text-red-800/80">Requires specific training, specialized puller tools, and EPA certifications.</span>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="text-red-500 text-lg mt-0.5">✕</span>
              <div>
                <strong class="block text-sm text-red-900 mb-1">Deep Error Code Diagnostics</strong>
                <span class="text-xs text-red-800/80">Interpreting manufacturer firmware error codes with proper digital diagnostic machines.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Brands We Service -->
  <section class="py-16 bg-gradient-to-b from-brand-surface to-white border-b border-gray-200 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#2DD4BF_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h3 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-8 flex items-center justify-center gap-3">
        <span class="w-8 h-px bg-brand-amber/30"></span>
        {applianceName} Brands Serviced Across Polk County
        <span class="w-8 h-px bg-brand-amber/30"></span>
      </h3>
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
        {brandsServiced.map((brand: string) => (
          <div class="group relative px-6 py-3 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden cursor-default">
            <div class="absolute inset-0 bg-gradient-to-r from-brand-teal/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <span class="relative z-10 font-heading font-bold text-sm sm:text-base text-brand-teal group-hover:text-brand-teal-dark transition-colors">
              {brand}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Markdown Render (Premium) -->
  <section class="py-20 bg-white border-b border-gray-100 relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-brand-surface/50 rounded-3xl p-8 sm:p-12 border border-brand-teal/10 shadow-lg relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-brand-amber/5 rounded-full blur-3xl -mr-32 -mt-32"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-brand-teal/5 rounded-full blur-3xl -ml-32 -mb-32"></div>
        <div class="prose prose-teal prose-lg max-w-none text-brand-muted relative z-10">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <FaqAccordion faqItems={faq} title={`${repairTitle} FAQs`} />

  <!-- Related Services Row -->
  <section class="py-16 bg-brand-bg border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-xl font-heading font-extrabold text-brand-teal mb-8">
        Other Home Appliance Repairs We Provide
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedServices.map((rel: any) => (
          <a
            href={`/services/${rel.id}`}
            class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-all group"
          >
            <div class="text-2xl mb-2">{rel.data.icon}</div>
            <h4 class="font-heading font-bold text-base text-brand-text group-hover:text-brand-teal transition-colors mb-1">
              {rel.data.title.endsWith(" Repair") ? rel.data.title : `${rel.data.title} Repair`}
            </h4>
            <p class="text-xs text-brand-muted line-clamp-2">{rel.data.shortDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA Banner -->
  <CtaBanner
    headline={`Need Urgent ${repairTitle} in Lakeland?`}
    subhead={`Call our local dispatch desk now at (863) 555-0123 for same-day service.`}
  />

</BaseLayout>
