---
export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  faqItems: FAQItem[];
  title?: string;
  subtitle?: string;
  isHomepage?: boolean;
}

const {
  faqItems = [],
  title = "Frequently Asked Questions",
  subtitle = "Have questions about our Polk County appliance repair services? Find clear answers below.",
  isHomepage = false
} = Astro.props;
---

<section class="py-16 sm:py-24 bg-white border-b border-gray-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {title && (
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-2">Got Questions?</h2>
        <p class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal tracking-tight">
          {title}
        </p>
        <p class="mt-3 text-sm text-brand-muted">
          {subtitle}
        </p>
      </div>
    )}

    <div class="space-y-4" id="faq-accordion-group">
      {faqItems.map((item, idx) => (
        <div class="bg-brand-bg rounded-2xl border border-gray-200 overflow-hidden shadow-sm transition-all faq-item">
          <button
            type="button"
            class="w-full px-6 py-5 text-left font-heading font-bold text-base text-brand-text flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-brand-teal faq-trigger group"
            aria-expanded="false"
            aria-controls={`faq-answer-${idx}`}
          >
            <span class="group-hover:text-brand-teal transition-colors pr-4">{item.question}</span>
            <span class="w-8 h-8 rounded-full bg-white text-brand-teal flex items-center justify-center font-bold text-lg flex-shrink-0 shadow-sm transition-transform duration-300 icon-arrow">
              +
            </span>
          </button>
          
          <div
            id={`faq-answer-${idx}`}
            class="faq-answer hidden px-6 pb-5 text-sm text-brand-muted leading-relaxed border-t border-gray-200/50 pt-3 bg-white"
          >
            <p>{item.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordionItems = document.querySelectorAll('.faq-item');

    accordionItems.forEach((item) => {
      const trigger = item.querySelector('.faq-trigger');
      const answer = item.querySelector('.faq-answer');
      const arrow = item.querySelector('.icon-arrow');

      if (trigger && answer && arrow) {
        trigger.addEventListener('click', () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';

          // Close all others if desired, or toggle current
          trigger.setAttribute('aria-expanded', (!isOpen).toString());
          answer.classList.toggle('hidden');
          arrow.textContent = isOpen ? '+' : '−';
          arrow.classList.toggle('bg-brand-amber');
          arrow.classList.toggle('text-slate-900');
        });
      }
    });
  });
</script>
