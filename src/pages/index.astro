---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

import WhyChooseUs from '../components/WhyChooseUs.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import DiyVsPro from '../components/DiyVsPro.astro';
import HealthSafety from '../components/HealthSafety.astro';
import CaseStudies from '../components/CaseStudies.astro';
import ServiceAreaGrid from '../components/ServiceAreaGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import SlimCta from '../components/SlimCta.astro';
import ServiceBenefits from '../components/ServiceBenefits.astro';

const homepageFaqs = [
  {
    question: "How fast can a technician near me arrive for a same-day repair in Lakeland?",
    answer: "Our technicians are stationed locally across Polk County. When you search for appliance repair near me and contact our Lakeland dispatch desk, average arrival times range from 30 to 60 minutes depending on your zip code."
  },
  {
    question: "What household appliances do you repair near me?",
    answer: "We provide comprehensive repairs for all major residential appliances near you, including built-in dishwashers, induction and ceramic cooktops, deep freezers, kitchen range hoods, refrigerators, ice makers, ovens, stoves, washing machines, and clothes dryers."
  },
  {
    question: "Why choose Lakeland Repair when searching for appliance repair near me?",
    answer: "Unlike national lead aggregators or out-of-town call centers, Lakeland Repair is 100% locally operated in Polk County. We provide upfront flat-rate pricing, van-stocked genuine OEM parts, licensed and background-checked technicians, and a rock-solid 90-day parts and labor warranty."
  },
  {
    question: "What type of warranty do you provide on parts and labor?",
    answer: "Every repair completed by Lakeland Repair comes with a comprehensive 90-day parts and labor warranty. If the same issue recurs within 90 days, we fix it at zero extra charge."
  },
  {
    question: "Which appliance brands do you service?",
    answer: "We service all major residential and commercial brands including Whirlpool, GE, Sub-Zero, LG, Samsung, Maytag, KitchenAid, Bosch, Frigidaire, Speed Queen, Viking, and Wolf."
  },
  {
    question: "Which specific areas in Polk County do you cover?",
    answer: "We cover all 10 major local zones: Downtown Lakeland, South Lakeland, Winter Haven, Plant City, Auburndale, Mulberry, Bartow, Highland City, Dixieland, and Lake Morton, as well as Davenport, Haines City, Lake Wales, and Polk City."
  }
];

const homepageFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homepageFaqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const pageTitle = "Appliance Repair Near Me in Lakeland, FL | Same-Day Service | Lakeland Repair";
const pageDescription = "Looking for reliable appliance repair near me? Lakeland Repair provides fast, same-day home appliance repair across Lakeland & Polk County, FL for dishwashers, cooktops, freezers, range hoods, refrigerators, washers, and dryers. Call (863) 278-0714.";
---

<BaseLayout title={pageTitle} description={pageDescription} schema={homepageFaqSchema}>
  
  <Hero />

  <!-- Dedicated SEO Section: Primary for Generic "Near Me" Searches -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-white via-brand-surface/50 to-white border-b border-gray-100 relative overflow-hidden">
    <!-- Soft Decorative Ambient Glows -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-brand-teal-light/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-brand-amber/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
        
        <!-- Left Content Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-50/90 border border-teal-200/90 text-brand-teal text-xs font-bold uppercase tracking-wider shadow-xs backdrop-blur-xs">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-success opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-success"></span>
            </span>
            #1 Local Choice for "Near Me" Searches
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-brand-teal-dark tracking-tight leading-tight">
            Top-Rated Appliance Repair Near Me in <span class="text-brand-teal">Lakeland & Polk County</span>
          </h2>

          <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-normal">
            When a crucial kitchen appliance or laundry unit breaks down, searching for dependable <strong>appliance repair near me</strong> shouldn't connect you to an impersonal national broker or an unverified handyman. At Lakeland Repair, our licensed master technicians are stationed locally across Central Florida to deliver true same-day in-home diagnostics and prompt repairs.
          </p>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            Every mobile repair unit in our fleet carries over 500 genuine OEM factory parts, allowing us to solve over 85% of customer problems on the spot. Whether you require precision diagnostic testing for high-demand refrigeration or delicate cooking controls, our local team is just minutes away from your doorstep.
          </p>
          
          <!-- Key Metric Stats Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5 pt-2">
            <div class="bg-gradient-to-b from-white to-teal-50/20 p-4 rounded-2xl border border-gray-200/90 shadow-sm hover:border-brand-teal/60 hover:shadow-lg hover:shadow-teal-950/5 hover:-translate-y-1 transition-all duration-300 text-center group">
              <span class="block text-2xl lg:text-3xl font-heading font-extrabold text-brand-teal group-hover:scale-105 transition-transform duration-300">30-60m</span>
              <span class="text-[11px] text-gray-600 font-bold block mt-1">Avg Arrival Time</span>
            </div>
            <div class="bg-gradient-to-b from-white to-amber-50/20 p-4 rounded-2xl border border-gray-200/90 shadow-sm hover:border-brand-amber/60 hover:shadow-lg hover:shadow-amber-500/5 hover:-translate-y-1 transition-all duration-300 text-center group">
              <span class="block text-2xl lg:text-3xl font-heading font-extrabold text-brand-amber group-hover:scale-105 transition-transform duration-300">90-Day</span>
              <span class="text-[11px] text-gray-600 font-bold block mt-1">Warranty Included</span>
            </div>
            <div class="bg-gradient-to-b from-white to-teal-50/20 p-4 rounded-2xl border border-gray-200/90 shadow-sm hover:border-brand-teal/60 hover:shadow-lg hover:shadow-teal-950/5 hover:-translate-y-1 transition-all duration-300 text-center group">
              <span class="block text-2xl lg:text-3xl font-heading font-extrabold text-brand-teal group-hover:scale-105 transition-transform duration-300">OEM</span>
              <span class="text-[11px] text-gray-600 font-bold block mt-1">Factory Parts</span>
            </div>
            <div class="bg-gradient-to-b from-white to-emerald-50/20 p-4 rounded-2xl border border-gray-200/90 shadow-sm hover:border-emerald-500/60 hover:shadow-lg hover:shadow-emerald-500/5 hover:-translate-y-1 transition-all duration-300 text-center group">
              <span class="block text-2xl lg:text-3xl font-heading font-extrabold text-emerald-600 group-hover:scale-105 transition-transform duration-300">100%</span>
              <span class="text-[11px] text-gray-600 font-bold block mt-1">Local Techs</span>
            </div>
          </div>
        </div>

        <!-- Featured Spotlight Card: Zero-Impression & Specialized Services -->
        <div class="lg:col-span-5 bg-gradient-to-b from-white to-brand-surface/30 rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-xl shadow-teal-950/5 relative space-y-6">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-widest text-brand-amber block mb-1">Direct Service Access</span>
              <h3 class="text-xl font-heading font-extrabold text-brand-teal-dark tracking-tight">
                Specialized In-Home Repairs
              </h3>
            </div>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-brand-success bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200/60 shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Truck-Ready
            </span>
          </div>

          <p class="text-xs text-brand-muted leading-relaxed">
            Select any of our dedicated repair services below for immediate diagnostic booking across Polk County:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <a 
              href="/services/dishwasher-repair/"
              class="p-4 rounded-2xl bg-white hover:bg-white border border-gray-200/90 hover:border-brand-teal hover:shadow-xl hover:shadow-teal-950/5 transition-all duration-300 group flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-2.5">
                  <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-100 flex items-center justify-center text-xl group-hover:scale-110 group-hover:bg-brand-amber/15 group-hover:border-amber-200 transition-all">
                    🍽️
                  </div>
                  <span class="text-[10px] font-bold text-teal-800 bg-teal-100/70 px-2 py-0.5 rounded-full uppercase tracking-wider">Kitchen</span>
                </div>
                <h4 class="text-sm font-heading font-extrabold text-brand-teal-dark group-hover:text-brand-teal transition-colors mb-1">
                  Dishwasher Repair
                </h4>
                <p class="text-[11px] text-gray-600 leading-snug">
                  Water leaks, drain pump blocks & spray arm calibration.
                </p>
              </div>
              <div class="mt-3.5 pt-2 border-t border-gray-100 flex items-center justify-between text-[11px] font-bold text-brand-teal group-hover:text-brand-amber transition-colors">
                <span>Book Diagnostic</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>

            <a 
              href="/services/cooktop-repair/"
              class="p-4 rounded-2xl bg-white hover:bg-white border border-gray-200/90 hover:border-brand-teal hover:shadow-xl hover:shadow-teal-950/5 transition-all duration-300 group flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-2.5">
                  <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-100 flex items-center justify-center text-xl group-hover:scale-110 group-hover:bg-brand-amber/15 group-hover:border-amber-200 transition-all">
                    🍳
                  </div>
                  <span class="text-[10px] font-bold text-teal-800 bg-teal-100/70 px-2 py-0.5 rounded-full uppercase tracking-wider">Cooking</span>
                </div>
                <h4 class="text-sm font-heading font-extrabold text-brand-teal-dark group-hover:text-brand-teal transition-colors mb-1">
                  Cooktop Repair
                </h4>
                <p class="text-[11px] text-gray-600 leading-snug">
                  Induction zones, smooth glass ceramic & heat switches.
                </p>
              </div>
              <div class="mt-3.5 pt-2 border-t border-gray-100 flex items-center justify-between text-[11px] font-bold text-brand-teal group-hover:text-brand-amber transition-colors">
                <span>Book Diagnostic</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>

            <a 
              href="/services/freezer-repair/"
              class="p-4 rounded-2xl bg-white hover:bg-white border border-gray-200/90 hover:border-brand-teal hover:shadow-xl hover:shadow-teal-950/5 transition-all duration-300 group flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-2.5">
                  <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-100 flex items-center justify-center text-xl group-hover:scale-110 group-hover:bg-brand-amber/15 group-hover:border-amber-200 transition-all">
                    ❄️
                  </div>
                  <span class="text-[10px] font-bold text-teal-800 bg-teal-100/70 px-2 py-0.5 rounded-full uppercase tracking-wider">Cooling</span>
                </div>
                <h4 class="text-sm font-heading font-extrabold text-brand-teal-dark group-hover:text-brand-teal transition-colors mb-1">
                  Freezer Repair
                </h4>
                <p class="text-[11px] text-gray-600 leading-snug">
                  Frost buildup, defrost heaters, thermostats & start relays.
                </p>
              </div>
              <div class="mt-3.5 pt-2 border-t border-gray-100 flex items-center justify-between text-[11px] font-bold text-brand-teal group-hover:text-brand-amber transition-colors">
                <span>Book Diagnostic</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>

            <a 
              href="/services/range-hood-repair/"
              class="p-4 rounded-2xl bg-white hover:bg-white border border-gray-200/90 hover:border-brand-teal hover:shadow-xl hover:shadow-teal-950/5 transition-all duration-300 group flex flex-col justify-between"
            >
              <div>
                <div class="flex items-center justify-between mb-2.5">
                  <div class="w-10 h-10 rounded-xl bg-teal-50 border border-teal-100 flex items-center justify-center text-xl group-hover:scale-110 group-hover:bg-brand-amber/15 group-hover:border-amber-200 transition-all">
                    🌬️
                  </div>
                  <span class="text-[10px] font-bold text-teal-800 bg-teal-100/70 px-2 py-0.5 rounded-full uppercase tracking-wider">Venting</span>
                </div>
                <h4 class="text-sm font-heading font-extrabold text-brand-teal-dark group-hover:text-brand-teal transition-colors mb-1">
                  Range Hood Repair
                </h4>
                <p class="text-[11px] text-gray-600 leading-snug">
                  Exhaust blower motors, grease duct flow & speed switches.
                </p>
              </div>
              <div class="mt-3.5 pt-2 border-t border-gray-100 flex items-center justify-between text-[11px] font-bold text-brand-teal group-hover:text-brand-amber transition-colors">
                <span>Book Diagnostic</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </div>
            </a>
          </div>

          <!-- Bottom Cross Links -->
          <div class="pt-3 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs">
            <span class="text-gray-500 font-semibold">Refrigeration & Laundry:</span>
            <div class="flex flex-wrap items-center gap-2">
              <a href="/services/refrigerator-repair/" class="px-2.5 py-1 rounded-lg bg-teal-50 hover:bg-brand-teal hover:text-white text-brand-teal font-bold transition-all shadow-2xs">Refrigerators</a>
              <a href="/services/washer-repair/" class="px-2.5 py-1 rounded-lg bg-teal-50 hover:bg-brand-teal hover:text-white text-brand-teal font-bold transition-all shadow-2xs">Washers</a>
              <a href="/services/dryer-repair/" class="px-2.5 py-1 rounded-lg bg-teal-50 hover:bg-brand-teal hover:text-white text-brand-teal font-bold transition-all shadow-2xs">Dryers</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <div data-aos="fade-up"><WhyChooseUs isHomepage={true} /></div>
  <!-- Display all 13 services to ensure complete indexation of zero-impression pages -->
  <div data-aos="fade-up"><ServicesGrid /></div>
  <div data-aos="fade-up"><SlimCta text="Broken appliance? Our Lakeland dispatch desk is ready." /></div>
  <div data-aos="fade-up"><ProcessSteps isHomepage={true} /></div>
  <div data-aos="fade-up"><DiyVsPro /></div>
  <div data-aos="fade-up"><HealthSafety limit={3} /></div>
  <div data-aos="fade-up"><CaseStudies /></div>
  <div data-aos="fade-up"><ServiceBenefits /></div>
  <div data-aos="fade-up"><ServiceAreaGrid /></div>
  <div data-aos="fade-up"><FaqAccordion faqItems={homepageFaqs} isHomepage={true} /></div>
  <div data-aos="fade-in"><CtaBanner /></div>

</BaseLayout>
