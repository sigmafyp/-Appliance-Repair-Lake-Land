---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const pageTitle = "Frequently Asked Questions | Lakeland Repair";
const pageDescription = "Find answers to the most common appliance repair questions in Lakeland and Polk County.";

const faqs = [
  {
    question: "How fast can a technician arrive for a same-day repair in Lakeland?",
    answer: "Our technicians are stationed locally across Polk County. When you call our dispatch desk, average arrival times range from 30 to 60 minutes depending on your zip code."
  },
  {
    question: "What type of warranty do you provide on parts and labor?",
    answer: "Every repair completed by Lakeland Repair comes with a comprehensive 90-day parts and labor warranty. If the same issue recurs within 90 days, we fix it at zero extra charge."
  },
  {
    question: "Which appliance brands do you service?",
    answer: "We service all major residential and commercial brands including Whirlpool, GE, Sub-Zero, LG, Samsung, Maytag, KitchenAid, Bosch, Frigidaire, Speed Queen, Viking, and Wolf."
  },
  {
    question: "What should I expect during an in-home repair visit?",
    answer: "Our technician will arrive in uniform with floor protection, perform a detailed diagnostic check, provide an itemized flat-rate estimate upfront, and complete the repair with genuine factory parts upon your approval."
  },
  {
    question: "Which specific areas in Polk County do you cover?",
    answer: "We cover all 10 major local zones: Downtown Lakeland, South Lakeland, Winter Haven, Plant City, Auburndale, Mulberry, Bartow, Highland City, Dixieland, and Lake Morton."
  },
  {
    question: "Do you charge a service call fee?",
    answer: "Yes, we charge a standard diagnostic fee to cover the technician's travel, fuel, and the time required to accurately diagnose the problem. However, if you choose to proceed with the repair on the same day, this diagnostic fee is completely waived and applied toward your final repair cost."
  },
  {
    question: "Are your technicians certified and insured?",
    answer: "Absolutely. All of our appliance repair technicians are fully certified, bonded, and insured. They undergo rigorous background checks and continuous training on the latest appliance models and technologies."
  },
  {
    question: "Do you offer emergency or after-hours repair services?",
    answer: "Yes, we understand that a broken refrigerator or leaking washer can't always wait. We offer emergency service scheduling. Please call our dispatch line directly for immediate after-hours availability."
  },
  {
    question: "Should I repair or replace my broken appliance?",
    answer: "Our technicians will provide an honest assessment. As a general rule, if the repair cost is less than 50% of the price of a new appliance and your unit is less than 10 years old, a repair is usually the most cost-effective choice."
  },
  {
    question: "What payment methods do you accept?",
    answer: "We accept all major credit and debit cards (Visa, MasterCard, American Express, Discover), as well as cash and corporate checks. Payment is due upon completion of the repair."
  },
  {
    question: "Do you repair commercial appliances?",
    answer: "Yes, we provide light commercial appliance repair for businesses like restaurants, laundromats, and offices. We service commercial refrigerators, freezers, ovens, and heavy-duty washers."
  },
  {
    question: "How long does a typical repair take?",
    answer: "Most repairs are completed within 1 to 2 hours. Our technicians drive fully-stocked vans with the most common OEM parts, allowing us to boast a 98% first-visit resolution rate."
  },
  {
    question: "Do you sell appliance parts?",
    answer: "We do not operate a retail parts counter. We provide parts strictly in conjunction with our in-home repair services to ensure warranty integrity and proper installation."
  },
  {
    question: "How do I schedule a service call?",
    answer: "Scheduling is immediate—simply call our local dispatch desk at (863) 278-0714. A technician coordinator will confirm your appliance symptoms and dispatch a specialist directly to your home."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://appliancerepairlakelandfl.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "FAQ",
      "item": "https://appliancerepairlakelandfl.com/faq/"
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={[faqSchema, breadcrumbSchema]}>
  <PageHeader 
    badge="Help & Answers"
    title="Frequently Asked Questions" 
    description="Have questions about diagnostic pricing, warranty coverage, or response times in Polk County? Find clear answers below." 
    showPhoneCta={true}
    secondaryBtnText="Contact Dispatch"
    secondaryBtnHref="/contact/"
  />

  <FaqAccordion faqItems={faqs} title="" subtitle="" />
</BaseLayout>
