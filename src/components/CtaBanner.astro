---
export interface Props {
  headline?: string;
  subhead?: string;
  showSecondary?: boolean;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  headline = "Ready to Restore Your Appliance Today?",
  subhead = "Our Polk County technicians are standing by. Call now for same-day dispatch and upfront, honest repair pricing.",
  showSecondary = true,
  secondaryText = "View All Services",
  secondaryHref = "/services/"
} = Astro.props;
---

<section class="bg-gradient-to-r from-brand-teal-dark via-brand-teal to-brand-teal-dark text-white py-16 lg:py-20 relative overflow-hidden">
  <!-- Decorative Water Gradient Wash -->
  <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#F2994A_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
    
    <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-teal-800/90 text-brand-amber text-xs font-extrabold uppercase tracking-widest border border-teal-600/50">
      ⚡ Same-Day Lakeland Repair Dispatch
    </div>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white tracking-tight leading-tight max-w-3xl mx-auto">
      {headline}
    </h2>

    <p class="text-base sm:text-lg text-teal-100 max-w-2xl mx-auto font-normal leading-relaxed">
      {subhead}
    </p>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="tel:8635550123"
        class="w-full sm:w-auto inline-flex items-center justify-center px-9 py-4 rounded-full bg-brand-amber text-slate-900 font-extrabold text-lg hover:bg-brand-amber-hover transition-all transform hover:-translate-y-0.5 shadow-2xl group"
      >
        <svg class="w-6 h-6 mr-3 text-slate-900 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Call (863) 555-0123 Now
      </a>

      {showSecondary && (
        <a
          href={secondaryHref}
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full bg-teal-800/80 hover:bg-teal-700/80 border border-teal-500/50 text-white font-bold text-base transition-colors"
        >
          {secondaryText}
        </a>
      )}
    </div>

    <!-- Restated Trust Line -->
    <div class="pt-6 text-xs text-teal-200/80 flex flex-wrap items-center justify-center gap-6">
      <span class="flex items-center"><strong class="text-white mr-1">✓</strong> No Hidden Diagnostics Fees</span>
      <span class="flex items-center"><strong class="text-white mr-1">✓</strong> 90-Day Parts & Labor Warranty</span>
      <span class="flex items-center"><strong class="text-white mr-1">✓</strong> Licensed & Insured FL Trade Pro</span>
    </div>

  </div>
</section>
