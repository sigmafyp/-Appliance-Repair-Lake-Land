---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Page Not Found (404) | Lakeland Repair";
const pageDescription = "The page you are looking for might have been removed, had its name changed, or is temporarily unavailable. Browse our appliance repair services or call for same-day dispatch.";

const popularServices = [
  { name: "Refrigerator Repair", href: "/services/refrigerator-repair/", icon: "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" },
  { name: "Washer Repair", href: "/services/washer-repair/", icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" },
  { name: "Dryer Repair", href: "/services/dryer-repair/", icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" },
  { name: "Oven & Range Repair", href: "/services/oven-range-repair/", icon: "M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" },
  { name: "Dishwasher Repair", href: "/services/dishwasher-repair/", icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" },
  { name: "Cooktop Repair", href: "/services/cooktop-repair/", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
];

const popularAreas = [
  { name: "Downtown Lakeland", href: "/areas/" },
  { name: "South Lakeland", href: "/areas/" },
  { name: "Winter Haven", href: "/areas/" },
  { name: "Plant City", href: "/areas/" },
  { name: "Bartow", href: "/areas/" },
  { name: "Auburndale", href: "/areas/" },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="relative bg-gradient-to-b from-brand-teal-bg/60 via-white to-brand-bg py-20 lg:py-28 overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-brand-teal/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-brand-amber/10 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <!-- 404 Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-amber-light border border-brand-amber/30 text-brand-amber font-bold text-sm uppercase tracking-wider mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-brand-amber animate-ping"></span>
        Error 404 • Page Not Found
      </div>

      <!-- Main Headline -->
      <h1 class="text-6xl sm:text-7xl lg:text-8xl font-heading font-extrabold text-brand-teal tracking-tight mb-4">
        4<span class="text-brand-amber">0</span>4
      </h1>

      <h2 class="text-2xl sm:text-3xl font-heading font-bold text-brand-text mb-4">
        Looks Like This Appliance Part Is Missing!
      </h2>

      <p class="text-lg text-brand-muted max-w-xl mx-auto mb-8 leading-relaxed">
        The page you are looking for might have been moved, had its URL updated, or is temporarily out of service. Don't worry, our team can still help you get your appliances running smoothly.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a 
          href="/" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-brand-teal text-white font-semibold text-base shadow-lg shadow-brand-teal/20 hover:bg-brand-teal-dark hover:shadow-xl transition-all duration-200"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Homepage
        </a>

        <a 
          href="tel:8635550123" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-brand-amber text-white font-semibold text-base shadow-lg shadow-brand-amber/25 hover:bg-brand-amber-hover hover:shadow-xl transition-all duration-200"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call (863) 555-0123
        </a>

        <a 
          href="/contact/" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-white border border-gray-200 text-brand-text font-semibold text-base hover:bg-gray-50 hover:border-gray-300 transition-all duration-200 shadow-sm"
        >
          Contact Dispatch
        </a>
      </div>

      <!-- Quick Services Directory -->
      <div class="bg-white/90 backdrop-blur-md rounded-2xl p-8 border border-gray-100 shadow-xl text-left">
        <h3 class="text-xl font-heading font-bold text-brand-teal mb-4 text-center">
          Looking for a specific repair service?
        </h3>
        <p class="text-sm text-brand-muted text-center max-w-md mx-auto mb-6">
          Choose from our most requested residential & commercial appliance services across Polk County:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-8">
          {popularServices.map((service) => (
            <a 
              href={service.href} 
              class="flex items-center gap-3 p-3.5 rounded-xl border border-gray-100 hover:border-brand-teal/30 hover:bg-teal-50/50 transition-colors group"
            >
              <div class="w-9 h-9 rounded-lg bg-teal-50 text-brand-teal flex items-center justify-center flex-shrink-0 group-hover:bg-brand-teal group-hover:text-white transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon} />
                </svg>
              </div>
              <span class="text-sm font-semibold text-brand-text group-hover:text-brand-teal transition-colors">
                {service.name}
              </span>
            </a>
          ))}
        </div>

        <!-- Service Areas -->
        <div class="pt-6 border-t border-gray-100 text-center">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-muted block mb-3">
            Popular Service Locations:
          </span>
          <div class="flex flex-wrap justify-center gap-2">
            {popularAreas.map((area) => (
              <a 
                href={area.href}
                class="px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-brand-muted hover:bg-brand-teal hover:text-white transition-colors"
              >
                {area.name}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
