---
const steps = [
  {
    step: "01",
    title: "Call or Request Service",
    description: "Contact our Lakeland dispatch desk. We note your appliance symptoms and schedule a convenient window."
  },
  {
    step: "02",
    title: "In-Home Diagnostic",
    description: "Our certified technician arrives equipped with specialized tools to inspect hardware and isolate the issue."
  },
  {
    step: "03",
    title: "Clear Flat-Rate Quote",
    description: "You receive an exact itemized price for parts and labor before any tools touch your machine. No surprises."
  },
  {
    step: "04",
    title: "Precision OEM Repair",
    description: "With your approval, we install genuine factory replacement parts directly from our fully stocked vans."
  },
  {
    step: "05",
    title: "Final Verification",
    description: "We run a complete test cycle, clean up the workspace, and provide your written 90-day parts & labor warranty."
  }
];

export interface Props {
  isHomepage?: boolean;
}

const { isHomepage } = Astro.props;
---

<section id="process" class="py-20 bg-brand-bg border-b border-gray-200 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center justify-center space-x-2 px-4 py-1.5 rounded-full bg-white border border-gray-200 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-brand-amber animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-brand-amber">Hassle-Free Workflow</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal tracking-tight">
        Our Simple 5-Step Repair Process
      </h2>
      <p class="mt-4 text-lg text-brand-muted">
        From initial phone call to final test cycle, we keep you informed every step of the way.
      </p>
    </div>

    <!-- Timeline Grid -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-6 relative">
      <!-- Horizontal Connecting Line (Desktop) -->
      <div class="hidden md:block absolute top-8 left-10 right-10 h-0.5 bg-gradient-to-r from-teal-200 via-brand-teal to-teal-200 z-0"></div>
      
      {steps.map((item, index) => (
        <div class="relative z-10 flex flex-col group">
          <div class="w-16 h-16 mx-auto bg-white border-[3px] border-brand-bg rounded-2xl shadow-xl flex items-center justify-center mb-6 relative overflow-hidden group-hover:-translate-y-2 transition-transform duration-300">
            <div class="absolute inset-0 bg-gradient-to-br from-teal-50 to-teal-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <span class="font-heading font-black text-2xl text-brand-teal relative z-10 group-hover:scale-110 transition-transform">{item.step}</span>
          </div>
          
          <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 flex-grow relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-brand-amber to-transparent transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
            <h3 class="text-[15px] font-heading font-bold text-brand-text mb-2 text-center group-hover:text-brand-teal transition-colors">
              {item.title}
            </h3>
            <p class="text-xs text-brand-muted leading-relaxed text-center">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
