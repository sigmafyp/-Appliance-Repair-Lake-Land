---
const services = [
  {
    slug: 'refrigerator-repair',
    name: 'Refrigerator Repair',
    description: 'Expert diagnostics for cooling failures, compressor issues, and water dispenser leaks.',
    icon: '🧊',
    image: '/images/services/refrigerator-repair.jpg',
    features: ['Compressor replacement', 'Freon leak sealing', 'Temp calibration']
  },
  {
    slug: 'freezer-repair',
    name: 'Freezer Repair',
    description: 'Fast repair for frost buildup, click-on start relays, and temp fluctuations.',
    icon: '❄️',
    image: '/images/services/freezer-repair.jpg',
    features: ['Defrost heater repair', 'Start relay replacement', 'Door seal fixing']
  },
  {
    slug: 'washer-repair',
    name: 'Washer Repair',
    description: 'Resolving spin cycle failures, standing water, violent vibration, and door locks.',
    icon: '🧺',
    image: '/images/services/washer-repair.jpg',
    features: ['Drain pump unclogging', 'Tub bearing replacement', 'Drive belt fixes']
  },
  {
    slug: 'dryer-repair',
    name: 'Dryer Repair',
    description: 'Fixing no-heat symptoms, broken drive belts, thermal fuses, and loud squeaking.',
    icon: '🔥',
    image: '/images/services/dryer-repair.jpg',
    features: ['Heating element repair', 'Thermal fuse reset', 'Vent line clearing']
  },
  {
    slug: 'oven-range-repair',
    name: 'Oven & Range Repair',
    description: 'Calibrating uneven temperatures, faulty igniters, element burnt-outs, and control boards.',
    icon: '🍳',
    image: '/images/services/oven-range-repair.jpg',
    features: ['Gas igniter replacement', 'Bake element fixes', 'Control board repair']
  },
  {
    slug: 'stove-repair',
    name: 'Stove Repair',
    description: 'Gas valve repairs, electric burner replacement, and spark module troubleshooting.',
    icon: '⚡',
    image: '/images/services/stove-repair.jpg',
    features: ['Burner grate alignment', 'Spark module testing', 'Gas line safety']
  },
  {
    slug: 'cooktop-repair',
    name: 'Cooktop Repair',
    description: 'Smooth-top glass burner fixes, induction zone repairs, and surface controls.',
    icon: '🍳',
    image: '/images/services/cooktop-repair.jpg',
    features: ['Induction coil fixes', 'Glass top polishing', 'Knob replacements']
  },
  {
    slug: 'dishwasher-repair',
    name: 'Dishwasher Repair',
    description: 'Fixing cloudy glassware, spray arm clogs, door latch leaks, and pump drains.',
    icon: '🍽️',
    image: '/images/services/dishwasher-repair.jpg',
    features: ['Spray arm unclogging', 'Drain pump clearing', 'Latch sensor repair']
  },
  {
    slug: 'microwave-repair',
    name: 'Microwave Repair',
    description: 'Magnetron replacements, turntable repairs, door switch safety, and keypads.',
    icon: '📻',
    image: '/images/services/microwave-repair.jpg',
    features: ['Magnetron replacement', 'Door switch alignment', 'Turntable motor fixes']
  },
  {
    slug: 'ice-maker-repair',
    name: 'Ice Maker Repair',
    description: 'Solving hollow cubes, water valve jams, mechanical ejectors, and slow production.',
    icon: '🧊',
    image: '/images/services/ice-maker-repair.jpg',
    features: ['Water line unfreezing', 'Ejector motor repair', 'Filter replacement']
  },
  {
    slug: 'range-hood-repair',
    name: 'Range Hood Repair',
    description: 'Exhaust fan motor fixes, grease duct cleaning, light fixtures, and multi-speed switches.',
    icon: '🌬️',
    image: '/images/services/range-hood-repair.jpg',
    features: ['Exhaust motor fixes', 'Filter un-greasing', 'Halogen light repair']
  },
  {
    slug: 'garbage-disposal-repair',
    name: 'Garbage Disposal Repair',
    description: 'Unjamming flywheels, sealing sink flange leaks, and resetting reset buttons.',
    icon: '♻️',
    image: '/images/services/garbage-disposal-repair.jpg',
    features: ['Flywheel unjamming', 'Flange resealing', 'Reset button wiring']
  },
  {
    slug: 'commercial-appliance-repair',
    name: 'Commercial Appliance Repair',
    description: 'Heavy-duty restaurant, laundromat, and rental property appliance maintenance.',
    icon: '🏢',
    image: '/images/services/commercial-appliance-repair.jpg',
    features: ['High-capacity units', 'Prompt response times', 'Commercial-grade parts']
  }
];

export interface Props {
  limit?: number;
  hideHeader?: boolean;
}

const { limit, hideHeader = false } = Astro.props;
const displayServices = limit ? services.slice(0, limit) : services;
---

<section id="services" class="py-16 sm:py-24 bg-white border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {!hideHeader && (
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-amber mb-2">Complete Home & Business Solutions</h2>
        <p class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-teal tracking-tight">
          Comprehensive Appliance Services in Polk County
        </p>
        <p class="mt-4 text-base text-brand-muted">
          We repair all major household and light commercial brands. Every repair includes original OEM parts and our standard parts & labor warranty.
        </p>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {displayServices.map((s) => (
        <div class="bg-brand-surface rounded-2xl overflow-hidden shadow-sm border border-gray-200 transition-all duration-300 flex flex-col group hover:shadow-xl hover:border-brand-teal">
          <!-- Image Header -->
          <div class="relative h-48 overflow-hidden bg-slate-800">
            <img 
              src={s.image} 
              alt={`${s.name} in Polk County`} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90 group-hover:opacity-100"
              loading="lazy"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-brand-teal-dark to-transparent pt-12 pb-3 px-5">
              <div class="flex items-center gap-2 text-white">
                <span class="text-xl">{s.icon}</span>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-amber">Certified Repair</span>
              </div>
            </div>
          </div>
          
          <!-- Content Body -->
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-xl font-heading font-extrabold text-brand-teal-dark mb-2 leading-tight group-hover:text-brand-teal transition-colors">
              {s.name}
            </h3>
            <p class="text-[13px] text-gray-600 leading-relaxed mb-5">
              {s.description}
            </p>
            
            <!-- Features List -->
            <ul class="space-y-2 mb-8 border-l-2 border-brand-teal/30 pl-4">
              {s.features.map(feature => (
                <li class="flex items-center text-sm text-gray-700 font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-amber mr-2.5"></span>
                  {feature}
                </li>
              ))}
            </ul>
            
            <!-- Action Button -->
            <div class="mt-auto pt-2">
              <a 
                href={`/services/${s.slug}/`}
                class="flex items-center justify-between w-full text-sm font-bold text-white bg-brand-teal hover:bg-brand-teal-dark rounded-xl px-5 py-3.5 transition-all shadow-md group/btn"
              >
                <span>Explore Details</span>
                <svg class="w-4 h-4 transform group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    {limit && (
      <div class="text-center mt-12">
        <a href="/services/" class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white border-2 border-slate-100 text-brand-teal font-extrabold text-base hover:bg-brand-teal hover:border-brand-teal hover:text-white transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl group relative overflow-hidden">
          <span class="relative z-10 flex items-center">
            View All Repair Services
            <svg class="w-5 h-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </span>
        </a>
      </div>
    )}
  </div>
</section>
