---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Privacy Policy | Lakeland Repair";
const pageDescription = "Privacy policy and data protection standards for Lakeland Repair customers.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Custom Legal Hero -->
  <section class="relative bg-brand-teal text-white overflow-hidden py-16 lg:py-24 border-b border-teal-800">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-teal-700/40 via-brand-teal-dark to-brand-teal-dark z-0"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-teal-800/80 border border-teal-600/50 text-teal-100 text-xs font-semibold tracking-wide uppercase mb-6">
        <svg class="w-4 h-4 text-brand-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <span>Legal Documentation</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-white tracking-tight mb-4">
        Privacy Policy
      </h1>
      <p class="text-teal-100/80 text-sm">Last Updated: January 1, 2026</p>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-brand-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl shadow-xl border border-gray-100 p-8 sm:p-12 lg:p-16">
        
        <div class="prose prose-slate prose-lg max-w-none text-gray-600 marker:text-brand-teal">
          
          <div class="bg-brand-teal/5 border-l-4 border-brand-teal p-6 rounded-r-2xl mb-12">
            <p class="m-0 font-medium text-brand-teal-dark">
              At Lakeland Repair, we deeply respect your privacy. This policy outlines exactly how we handle the information you provide when requesting our services across Polk County.
            </p>
          </div>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">1. Information We Collect</h2>
          <p>
            When you request appliance repair services or contact us via our website form or telephone dispatch, we collect essential personal information required to deliver local service, including your name, physical address, phone number, email address, and appliance diagnostic details.
          </p>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">2. How We Use Your Information</h2>
          <p>
            We use the information collected solely for:
          </p>
          <ul>
            <li>Dispatching repair technicians to your location.</li>
            <li>Providing cost estimates and scheduling service windows.</li>
            <li>Processing payments and issuing 90-day warranty verification.</li>
          </ul>
          <p>
            <strong>We never sell, rent, or trade</strong> customer contact details to third-party advertisers.
          </p>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">3. SMS & Phone Communications</h2>
          <p>
            By providing your phone number, you consent to receive transactional phone calls and SMS text messages regarding technician ETA updates and appointment confirmations. You may opt out of non-essential communications at any time by replying "STOP".
          </p>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">4. Data Protection & Security</h2>
          <p>
            We implement industry-standard administrative and electronic safeguards to protect customer records against unauthorized access or disclosure.
          </p>

          <h2 class="text-2xl font-heading font-bold text-brand-teal-dark mt-10 mb-4 border-b border-gray-100 pb-4">5. Contact Information</h2>
          <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 mt-6">
            <p class="m-0 text-sm">
              If you have questions regarding our privacy practices, please contact our administrative desk:<br><br>
              <strong>Lakeland Appliance Pro</strong><br>
              120 E Pine St, Suite 4<br>
              Lakeland, FL 33801<br>
              Phone: (863) 555-0123
            </p>
          </div>

        </div>
      </div>
    </div>
  </section>

</BaseLayout>
