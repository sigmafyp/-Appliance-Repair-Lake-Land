---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const pageTitle = "Service Areas | Lakeland Repair";
const pageDescription = "We provide same-day appliance repair services across Polk County, FL, including Lakeland, Winter Haven, Bartow, and more.";

const areas = [
  { slug: 'downtown-lakeland', name: 'Downtown Lakeland', zip: '33801', responseTime: '30-60 mins', region: 'Central Lakeland', dedicatedTrucks: 3 },
  { slug: 'south-lakeland', name: 'South Lakeland', zip: '33813', responseTime: '45-60 mins', region: 'South Polk', dedicatedTrucks: 4 },
  { slug: 'dixieland-lakeland', name: 'Dixieland Lakeland', zip: '33803', responseTime: '30-45 mins', region: 'Central Lakeland', dedicatedTrucks: 2 },
  { slug: 'lake-morton-lakeland', name: 'Lake Morton Lakeland', zip: '33801', responseTime: '30-45 mins', region: 'Central Lakeland', dedicatedTrucks: 1 },
  { slug: 'winter-haven', name: 'Winter Haven', zip: '33880', responseTime: '45-90 mins', region: 'East Polk', dedicatedTrucks: 3 },
  { slug: 'auburndale', name: 'Auburndale', zip: '33823', responseTime: '45-75 mins', region: 'East Polk', dedicatedTrucks: 2 },
  { slug: 'haines-city', name: 'Haines City', zip: '33844', responseTime: '45-75 mins', region: 'East Polk', dedicatedTrucks: 2 },
  { slug: 'lake-wales', name: 'Lake Wales', zip: '33853', responseTime: '50-80 mins', region: 'East Polk', dedicatedTrucks: 2 },
  { slug: 'davenport', name: 'Davenport', zip: '33837', responseTime: '45-75 mins', region: 'Northeast Polk', dedicatedTrucks: 3 },
  { slug: 'polk-city', name: 'Polk City', zip: '33868', responseTime: '30-50 mins', region: 'North Polk', dedicatedTrucks: 2 },
  { slug: 'plant-city', name: 'Plant City', zip: '33563', responseTime: '60-90 mins', region: 'West Polk', dedicatedTrucks: 2 },
  { slug: 'mulberry', name: 'Mulberry', zip: '33860', responseTime: '45-75 mins', region: 'South Polk', dedicatedTrucks: 2 },
  { slug: 'bartow', name: 'Bartow', zip: '33830', responseTime: '60-90 mins', region: 'South Polk', dedicatedTrucks: 2 },
  { slug: 'highland-city', name: 'Highland City', zip: '33846', responseTime: '30-60 mins', region: 'South Polk', dedicatedTrucks: 1 },
];

const regions = [...new Set(areas.map(a => a.region))];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <!-- Custom Areas Hero -->
  <section class="relative bg-brand-teal text-white overflow-hidden py-16 lg:py-24 border-b border-teal-800">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-teal-dark to-brand-teal z-0"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-teal-light/20 rounded-full blur-3xl -mr-32 -mt-32 pointer-events-none z-0"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-extrabold text-white tracking-tight mb-6">
        Polk County Coverage Map
      </h1>
      <p class="text-xl text-teal-50/90 max-w-3xl mx-auto mb-10 leading-relaxed">
        Fast, local appliance repair right in your neighborhood. We have dedicated service trucks stationed across Polk County for rapid dispatch.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="tel:8635550123"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-brand-amber text-slate-900 font-extrabold text-base hover:bg-brand-amber-hover transition-all transform hover:-translate-y-0.5 shadow-xl group w-full sm:w-auto"
        >
          <svg class="w-5 h-5 mr-2 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Call (863) 555-0123
        </a>
        <a
          href="/services"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-teal-800/80 border border-teal-600/60 text-white font-bold text-base hover:bg-brand-teal-light transition-all transform hover:-translate-y-0.5 shadow-lg group w-full sm:w-auto"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
          View Services
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-brand-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      {regions.map(region => (
        <div class="mb-16 last:mb-0">
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-brand-teal">{region}</h2>
            <div class="h-px bg-gray-300 flex-grow"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {areas.filter(a => a.region === region).map((a) => (
              <div
                class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:border-brand-teal relative overflow-hidden"
              >
                <div class="absolute top-0 right-0 w-24 h-24 bg-brand-teal/5 rounded-bl-full -z-10 group-hover:scale-150 transition-transform duration-500"></div>
                
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-mono font-bold text-gray-500 bg-gray-100 px-3 py-1 rounded">
                      ZIP {a.zip}
                    </span>
                    <span class="text-[10px] font-bold bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full uppercase tracking-wider flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                      Active Units: {a.dedicatedTrucks}
                    </span>
                  </div>
                  
                  <h3 class="text-xl font-heading font-bold text-brand-text mb-2 group-hover:text-brand-teal transition-colors">
                    {a.name}
                  </h3>
                  
                  <div class="bg-brand-surface p-3 rounded-lg mt-4 flex items-center justify-between">
                    <span class="text-xs text-brand-muted font-medium">Avg Response Time</span>
                    <span class="text-sm font-bold text-brand-teal">{a.responseTime}</span>
                  </div>
                </div>
                
                <div class="pt-5 mt-4 border-t border-gray-100 flex items-center justify-between">
                  <div class="text-xs font-bold text-brand-success flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span>Servicing Now</span>
                  </div>

                  <a 
                    href={`/areas/${a.slug}/`}
                    class="text-xs font-bold text-brand-teal hover:text-brand-amber flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
                  >
                    <span>Area Details</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
      
    </div>
  </section>

  <CtaBanner />

</BaseLayout>
