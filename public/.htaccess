# ==============================================================================
# Appliance Repair Lakeland - Server Configuration (.htaccess)
# Designed for Apache & LiteSpeed (Hostinger)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTP to HTTPS Redirect
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]

  # 3. Remove index.html / index.php / index.aspx from directory URLs
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)index\.(html|php|aspx)[\ ?] [NC]
  RewriteRule ^(.*)index\.(html|php|aspx)$ /$1 [R=301,L,NC]

  # 4. Remove extensions (.html, .php, .aspx) and redirect to trailing slash
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^?\s]+)\.(html|php|aspx)[\ ?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
  RewriteRule ^ /%1/ [R=301,L]

  # 5. Add trailing slash to URLs without file extension
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !(.*)\.([a-zA-Z0-9]{1,5})$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# Custom 404 Error Document
ErrorDocument 404 /404.html

# Security & Cache Optimizations
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
