---
export interface Props {
  text?: string;
  buttonText?: string;
}

const { 
  text = "Need a fast appliance repair? Our Polk County dispatch is ready.", 
  buttonText = "Call (863) 278-0714" 
} = Astro.props;
---

<section class="bg-brand-teal text-white border-y border-teal-800 py-8 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-4">
      <div class="w-11 h-11 rounded-xl bg-brand-amber text-slate-900 flex items-center justify-center shrink-0 shadow-md">
        <svg class="w-6 h-6 text-slate-950" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
        </svg>
      </div>
      <h3 class="text-xl sm:text-2xl font-heading font-extrabold text-white">
        {text}
      </h3>
    </div>
    
    <a href="tel:+18632780714" class="w-full md:w-auto inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-brand-amber text-slate-900 font-extrabold text-base hover:bg-brand-amber-hover transition-all transform hover:-translate-y-0.5 shadow-lg shadow-amber-500/20">
      <svg class="w-5 h-5 mr-2 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      {buttonText}
    </a>
  </div>
</section>
