---
import { getCollection } from 'astro:content';

const services = await getCollection('services');
const areas = await getCollection('areas');
---

<header class="sticky top-0 z-50 bg-brand-teal text-white shadow-lg border-b border-brand-teal-light/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="w-10 h-10 rounded-lg bg-brand-amber flex items-center justify-center text-brand-teal font-extrabold text-xl shadow-md group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <span class="font-heading font-extrabold text-xl sm:text-2xl tracking-tight text-white block leading-none">
            Lakeland<span class="text-brand-amber">Pro</span>
          </span>
          <span class="text-[10px] tracking-wider text-teal-200 uppercase font-semibold block mt-0.5">
            Appliance Repair • Polk County
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-7 font-medium text-sm text-teal-50">
        <a href="/" class="hover:text-brand-amber transition-colors py-1">Home</a>
        
        <div class="relative group py-1">
          <a href="/services" class="hover:text-brand-amber transition-colors flex items-center gap-1 border-b-2 border-transparent group-hover:border-brand-teal-light pb-1">
            Services
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
            <div class="w-72 bg-[#0B1527] border border-slate-700/50 rounded shadow-2xl overflow-hidden">
              <ul class="max-h-[400px] overflow-y-auto custom-scrollbar py-2">
                {services.map(service => (
                  <li>
                    <a href={`/services/${service.slug}`} class="flex items-center px-4 py-2.5 hover:bg-slate-800/50 transition-colors text-slate-200 hover:text-white gap-3">
                      <div class="text-brand-teal w-5 h-5 flex-shrink-0" set:html={service.data.icon} />
                      <span class="text-sm font-medium">{service.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <a href="/#process" class="hover:text-brand-amber transition-colors py-1">Process</a>
        <a href="/about" class="hover:text-brand-amber transition-colors py-1">About</a>
        <a href="/#safety" class="hover:text-brand-amber transition-colors py-1">Safety</a>
        
        <div class="relative group py-1">
          <a href="/areas" class="hover:text-brand-amber transition-colors flex items-center gap-1 border-b-2 border-transparent group-hover:border-brand-teal-light pb-1">
            Areas
            <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
            <div class="w-56 bg-[#0B1527] border border-slate-700/50 rounded shadow-2xl overflow-hidden">
              <ul class="max-h-[400px] overflow-y-auto custom-scrollbar py-2">
                {areas.map(area => (
                  <li>
                    <a href={`/areas/${area.slug}`} class="block px-4 py-2.5 hover:bg-slate-800/50 transition-colors text-slate-200 hover:text-white text-sm font-medium">
                      {area.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <a href="/faq" class="hover:text-brand-amber transition-colors py-1">FAQ</a>
      </nav>

      <!-- Desktop Phone CTA -->
      <div class="hidden md:flex items-center space-x-4">
        <a 
          href="tel:8635550123" 
          class="inline-flex items-center px-5 py-2.5 rounded-full bg-brand-amber text-slate-900 font-bold text-sm hover:bg-brand-amber-hover transition-all transform hover:-translate-y-0.5 shadow-md group"
          id="header-phone-cta"
        >
          <svg class="w-4 h-4 mr-2 text-slate-900 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>(863) 555-0123</span>
          <span class="ml-1.5 text-xs bg-slate-900 text-brand-amber px-2 py-0.5 rounded-full font-bold uppercase">Call Now</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center space-x-3">
        <a href="tel:8635550123" class="md:hidden inline-flex items-center px-3 py-1.5 rounded-full bg-brand-amber text-slate-900 font-bold text-xs">
          (863) 555-0123
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-lg text-teal-100 hover:text-white hover:bg-brand-teal-light focus:outline-none focus:ring-2 focus:ring-brand-amber"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-brand-teal-dark border-t border-teal-700/50 px-4 pt-3 pb-6 space-y-3">
    <a href="/" class="block px-3 py-2 rounded-md font-medium text-teal-50 hover:bg-brand-teal hover:text-brand-amber">Home</a>
    <a href="/services" class="block px-3 py-2 rounded-md font-medium text-teal-50 hover:bg-brand-teal hover:text-brand-amber">Services</a>
    <a href="/#process" class="block px-3 py-2 rounded-md font-medium text-teal-50 hover:bg-brand-teal hover:text-brand-amber">Process</a>
    <a href="/about" class="block px-3 py-2 rounded-md font-medium text-teal-50 hover:bg-brand-teal hover:text-brand-amber">About Us</a>
    <a href="/team" class="block px-3 py-2 rounded-md font-medium text-teal-50 hover:bg-brand-teal hover:text-brand-amber">Our Team</a>
    <a href="/#safety" class="block px-3 py-2 rounded-md font-medium text-teal-50 hover:bg-brand-teal hover:text-brand-amber">Health & Safety</a>
    <a href="/areas" class="block px-3 py-2 rounded-md font-medium text-teal-50 hover:bg-brand-teal hover:text-brand-amber">Service Areas</a>
    <a href="/faq" class="block px-3 py-2 rounded-md font-medium text-teal-50 hover:bg-brand-teal hover:text-brand-amber">FAQ</a>
    <a href="/contact" class="block px-3 py-2 rounded-md font-medium text-teal-50 hover:bg-brand-teal hover:text-brand-amber">Contact Us</a>
    <div class="pt-2">
      <a href="tel:8635550123" class="w-full inline-flex justify-center items-center px-5 py-3 rounded-xl bg-brand-amber text-slate-900 font-bold text-base shadow-md">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Call Now: (863) 555-0123
      </a>
    </div>
  </div>
</header>

<script>
  // Vanilla JS Mobile Menu Toggle
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (btn && menu && iconOpen && iconClose) {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', (!isExpanded).toString());
        menu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      });
    }
  });
</script>
