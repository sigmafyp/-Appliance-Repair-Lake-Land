---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

import WhyChooseUs from '../components/WhyChooseUs.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import DiyVsPro from '../components/DiyVsPro.astro';
import HealthSafety from '../components/HealthSafety.astro';
import CaseStudies from '../components/CaseStudies.astro';
import ServiceAreaGrid from '../components/ServiceAreaGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import SlimCta from '../components/SlimCta.astro';
import ServiceBenefits from '../components/ServiceBenefits.astro';

const homepageFaqs = [
  {
    question: "How fast can a technician arrive for a same-day repair in Lakeland?",
    answer: "Our technicians are stationed locally across Polk County. When you call our dispatch desk, average arrival times range from 30 to 60 minutes depending on your zip code."
  },
  {
    question: "What type of warranty do you provide on parts and labor?",
    answer: "Every repair completed by Lakeland Repair comes with a comprehensive 90-day parts and labor warranty. If the same issue recurs within 90 days, we fix it at zero extra charge."
  },
  {
    question: "Which appliance brands do you service?",
    answer: "We service all major residential and commercial brands including Whirlpool, GE, Sub-Zero, LG, Samsung, Maytag, KitchenAid, Bosch, Frigidaire, Speed Queen, Viking, and Wolf."
  },
  {
    question: "What should I expect during an in-home repair visit?",
    answer: "Our technician will arrive in uniform with floor protection, perform a detailed diagnostic check, provide an itemized flat-rate estimate upfront, and complete the repair with genuine factory parts upon your approval."
  },
  {
    question: "Which specific areas in Polk County do you cover?",
    answer: "We cover all 10 major local zones: Downtown Lakeland, South Lakeland, Winter Haven, Plant City, Auburndale, Mulberry, Bartow, Highland City, Dixieland, and Lake Morton."
  }
];

const pageTitle = "Lakeland Repair | Premium Appliance Repair in Lakeland, FL";
const pageDescription = "Polk County's most trusted experts for premium home appliance repairs. Fast, reliable service for refrigerators, washers, dryers, ovens, dishwashers, and more.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  
  <Hero />
  <div data-aos="fade-up"><WhyChooseUs isHomepage={true} /></div>
  <div data-aos="fade-up"><ServicesGrid limit={9} /></div>
  <div data-aos="fade-up"><SlimCta text="Broken appliance? Our Lakeland dispatch desk is ready." /></div>
  <div data-aos="fade-up"><ProcessSteps isHomepage={true} /></div>
  <div data-aos="fade-up"><DiyVsPro /></div>
  <div data-aos="fade-up"><HealthSafety limit={3} /></div>
  <div data-aos="fade-up"><CaseStudies /></div>
  <div data-aos="fade-up"><ServiceBenefits /></div>
  <div data-aos="fade-up"><ServiceAreaGrid /></div>
  <div data-aos="fade-up"><FaqAccordion faqItems={homepageFaqs} isHomepage={true} /></div>
  <div data-aos="fade-in"><CtaBanner /></div>

</BaseLayout>
