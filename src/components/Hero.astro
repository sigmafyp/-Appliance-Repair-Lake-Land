---
export interface Props {
  heading?: string;
  subhead?: string;
  badgeText?: string;
  image?: string;
  showBadges?: boolean;
}

const {
  heading = "Fast, Reliable Appliance Repair Near Me in Lakeland, FL",
  subhead = "Polk County's most trusted experts for same-day appliance repair near you. Restoring calm and efficiency to your kitchen and laundry room with genuine OEM parts and a 90-day guarantee.",
  badgeText = "Polk County's Top Rated Local Technicians",
  image = "/images/hero/hero-tech.jpg",
  showBadges = true
} = Astro.props;
---

<section class="relative bg-gradient-to-b from-brand-teal-dark via-brand-teal to-brand-teal-dark text-white overflow-hidden pt-12 pb-16 lg:pt-16 lg:pb-24 border-b border-teal-800">
  <!-- Subtle Background Ripple Texture Overlay -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F2994A_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
  
  <!-- Soft Ambient Glow -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-teal-light/20 rounded-full blur-3xl -mr-32 -mt-32 pointer-events-none z-0"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-amber/10 rounded-full blur-3xl -ml-24 -mb-24 pointer-events-none z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text & CTA Content -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-teal-800/80 border border-teal-600/50 text-brand-amber text-xs font-semibold tracking-wide uppercase">
          <svg class="w-4 h-4 text-brand-amber" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
          </svg>
          <span>{badgeText}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-white tracking-tight leading-tight">
          {heading}
        </h1>

        <p class="text-lg sm:text-xl text-teal-100/90 max-w-2xl font-normal leading-relaxed">
          {subhead}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center space-y-3 sm:space-y-0 sm:space-x-4 pt-2">
          <a
            href="tel:+18632780714"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-brand-amber text-slate-900 font-extrabold text-base hover:bg-brand-amber-hover transition-all transform hover:-translate-y-0.5 shadow-xl group text-center"
          >
            <svg class="w-5 h-5 mr-2.5 text-slate-900 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Call (863) 278-0714 Now
          </a>

          <a
            href="/services/"
            class="inline-flex items-center justify-center px-7 py-4 rounded-full bg-teal-800/80 hover:bg-brand-teal-light border border-teal-600/60 text-white font-bold text-base transition-all duration-300 transform hover:scale-105 hover:shadow-lg hover:border-teal-400 group text-center"
          >
            View Services
            <svg class="w-4 h-4 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
        </div>

        <!-- 3 Inline Trust Badges -->
        {showBadges && (
          <div class="pt-6 grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-teal-800/80">
            <div class="flex items-center space-x-3 p-2.5 rounded-xl bg-teal-950/40 border border-teal-700/40 text-xs text-teal-100">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold flex-shrink-0">
                ✓
              </div>
              <div>
                <span class="font-bold block text-white leading-tight">Licensed & Insured</span>
                <span class="text-[10px] text-teal-300">FL State Certified</span>
              </div>
            </div>
            <div class="flex items-center space-x-3 p-2.5 rounded-xl bg-teal-950/40 border border-teal-700/40 text-xs text-teal-100">
              <div class="w-7 h-7 rounded-lg bg-brand-amber/20 border border-brand-amber/30 flex items-center justify-center text-brand-amber font-bold flex-shrink-0">
                <svg class="w-4 h-4 text-brand-amber" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <span class="font-bold block text-white leading-tight">Same-Day Dispatch</span>
                <span class="text-[10px] text-teal-300">Within 2–4 Hours</span>
              </div>
            </div>
            <div class="flex items-center space-x-3 p-2.5 rounded-xl bg-teal-950/40 border border-teal-700/40 text-xs text-teal-100">
              <div class="w-7 h-7 rounded-lg bg-amber-400/20 border border-amber-400/30 flex items-center justify-center text-amber-300 font-bold flex-shrink-0">
                ★
              </div>
              <div>
                <span class="font-bold block text-white leading-tight">500+ Reviews</span>
                <span class="text-[10px] text-teal-300">4.9 / 5.0 Star Rating</span>
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Hero Visual Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-teal-700/50 bg-teal-900 group">
          <picture>
            <img
              src="/images/hero/hero-tech.jpg"
              alt="Lakeland Appliance Pro Certified Repair Technician at Work"
              class="w-full h-80 lg:h-[440px] object-cover group-hover:scale-105 transition-transform duration-700"
              fetchpriority="high"
              decoding="sync"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-brand-teal-dark via-brand-teal-dark/30 to-transparent opacity-90"></div>
          
          <!-- Top Floating OEM Badge -->
          <div class="absolute top-4 right-4 px-3 py-1.5 rounded-full bg-slate-950/80 backdrop-blur-md border border-teal-500/40 text-[11px] font-bold text-teal-200 flex items-center gap-1.5 shadow-lg">
            <span class="text-brand-amber font-mono font-extrabold">OEM</span> Factory Parts Stocked
          </div>

          <!-- Bottom Status Card -->
          <div class="absolute bottom-4 left-4 right-4 p-4 rounded-2xl bg-brand-teal-dark/90 backdrop-blur-md border border-teal-600/50 shadow-xl text-xs">
            <div class="flex items-center justify-between gap-3">
              <div>
                <span class="text-brand-amber font-extrabold block text-sm tracking-tight">Lakeland Master Dispatch</span>
                <span class="text-teal-200 text-[11px]">Direct coverage across all 10 Polk County areas</span>
              </div>
              <div class="flex items-center space-x-1.5 bg-emerald-500/20 text-emerald-300 font-bold px-3 py-1.5 rounded-full text-[11px] border border-emerald-500/30 shrink-0">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span>Active Today</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
